# Build context of docker/next/api/Dockerfile (repository root): deny everything, then
# admit what the publish reads. BuildKit prefers this file to the root .dockerignore,
# which serves the legacy images.
*

!global.json
!Directory.Build.props
!Directory.Packages.props
!.editorconfig
!src/LoDb.Domain/
!src/LoDb.Infrastructure/
!src/LoDb.Ingestion/
!src/LoDb.Api/

# Host build outputs would shadow the container's own restore.
**/bin/
**/obj/
src/LoDb.Api/openapi/
