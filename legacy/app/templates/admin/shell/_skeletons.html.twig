{# Loading placeholders for the async admin panels — consumed by _ui.html.twig's
   panel(). They mirror the panel's real shape, so the swap-in shifts nothing.
   kind: kpi (tiles only) | chart (tiles + time series) | cards (tiles + card row). #}
{% macro skeleton(kind, tiles) %}
    {% import _self as sk %}
    <div class="kpi-grid" style="margin-bottom: 1.15rem;">
        {% for i in 1..(tiles|default(4)) %}<div class="kpi sk sk-kpi"></div>{% endfor %}
    </div>
    {% if kind == 'chart' %}
        <section class="card">
            <div class="sk sk-line short" style="margin-bottom: 1.15rem;"></div>
            <div class="sk sk-chart"></div>
        </section>
    {% elseif kind != 'kpi' %}
        <div class="grid cols-3">{% for i in 1..3 %}{{ sk.skeleton_card() }}{% endfor %}</div>
    {% endif %}
{% endmacro %}

{% macro skeleton_card(rows) %}
    <section class="card">
        <div class="sk sk-line short" style="margin-bottom: 1.15rem;"></div>
        <div class="sk-stack">
            {% for r in 1..(rows|default(4)) %}
                <div class="sk sk-line {{ r is odd ? 'mid' }}"></div>
                <div class="sk sk-bar"></div>
            {% endfor %}
        </div>
    </section>
{% endmacro %}
