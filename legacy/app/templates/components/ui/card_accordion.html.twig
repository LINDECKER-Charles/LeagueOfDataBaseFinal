{# Collapsible section at the foot of an entity card (categories, evolutions,
   modes, description). The chrome — top rule, summary row, chevron — lives here
   so the list pages cannot drift apart one copy at a time.

   Use with {% embed %} and fill `accordion_body`:
     {% embed 'components/ui/card_accordion.html.twig' with { label: '…' } %}
       {% block accordion_body %}…{% endblock %}
     {% endembed %}

   Params: label (required), count (optional counter shown next to the label). #}
<details class="group/acc border-t border-gold-deep/30">
  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5
                  font-mono text-[11px] uppercase tracking-wider text-text-muted
                  hover:text-hex">
    <span>{{ label }}{% if count is defined and count is not null %}
      <span class="text-hex">({{ count }})</span>{% endif %}</span>
    <svg class="h-3.5 w-3.5 transition-transform group-open/acc:rotate-180"
         viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd"
         d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24
            4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z"
         clip-rule="evenodd"/></svg>
  </summary>
  {% block accordion_body %}{% endblock %}
</details>
