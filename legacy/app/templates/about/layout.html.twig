{# Shared shell of the editorial pages (/about, /about/data, /faq): codex banner
   (eyebrow + title + lead), then the prose column. Children fill page_title,
   page_lead and about_body, and bring their own structured_data.
   Unlike legal/*, the copy is fully translatable — everything goes through
   |trans on the `about` domain, so the 21 catalogs drive all three pages. #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Only the fact grid is page-scoped; the prose typography is shared
       (.hx-prose in assets/styles/foundation/prose.css). #}
    <style>
        /* Fact grid — the countable claims (patch, entry counts, languages). */
        .about-facts {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
            margin: 1.5rem 0;
        }
        .about-fact {
            border: 1px solid color-mix(in srgb, var(--color-gold-deep) 45%, transparent);
            background: color-mix(in srgb, var(--color-void) 70%, transparent);
            padding: 0.9rem 1rem;
        }
        .about-fact__value {
            display: block;
            font-family: var(--font-beaufort);
            font-size: 1.75rem;
            line-height: 1.1;
            color: var(--color-hex-bright);
        }
        .about-fact__label {
            display: block;
            margin-top: 0.35rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--color-text-dim);
        }
    </style>
{% endblock %}

{% block body %}
<main class="relative mx-auto w-full max-w-3xl px-6 pb-20 pt-10 sm:px-8 lg:pt-14">
    {% include 'partials/main/gradient.html.twig' %}

    <header class="relative mb-10">
        <div class="codex-header mb-6">
            <span class="codex-header__title">{{ 'eyebrow'|trans({}, 'about') }}</span>
        </div>
        <h1 class="mb-5 font-beaufort text-3xl uppercase tracking-[0.06em] text-gold-grad
                   sm:text-4xl">{{ block('page_title') }}</h1>
        <p class="max-w-[62ch] font-spiegel text-lg leading-relaxed
                  text-text-muted">{% block page_lead %}{% endblock %}</p>
    </header>

    <div class="hx-prose relative flex flex-col gap-10">
        {% block about_body %}{% endblock %}
    </div>
</main>
{% endblock %}
