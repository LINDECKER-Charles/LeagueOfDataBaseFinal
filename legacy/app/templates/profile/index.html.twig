{% extends 'base.html.twig' %}

{% block title %}{{ user.displayName }} · {{ 'base.title'|trans }}{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
{% set slotDefs = [
    { type: 'champion', field: 'favoriteChampionId', label: 'profile.slot.champion'|trans },
    { type: 'item', field: 'favoriteItemId', label: 'profile.slot.item'|trans },
    { type: 'rune', field: 'favoriteRuneId', label: 'profile.slot.rune'|trans },
    { type: 'summoner', field: 'favoriteSummonerId', label: 'profile.slot.summoner'|trans },
] %}
{% set pickerSlots = [] %}
{% for def in slotDefs %}
    {% set fav = favorites[def.type] %}
    {% set pickerSlots = pickerSlots|merge([{
        type: def.type,
        fieldName: def.field,
        typeLabel: def.label,
        current: fav.current
            ? { id: fav.current.id, name: fav.current.name, image: fav.current.image }
            : null,
        storedId: fav.storedId,
        emptyLabel: 'profile.favorites.empty'|trans,
    }]) %}
{% endfor %}
{# Favorites set on the account, decorated discreetly over the cover. #}
{% set orbSlots = [] %}
{% for slot in ['champion', 'item', 'rune', 'summoner'] %}
    {% if favorites[slot].current %}{% set orbSlots = orbSlots|merge([slot]) %}{% endif %}
{% endfor %}
<main class="profile-perso relative px-6 py-12">
    {% if personalBackground %}
        {# Favorite champion, dimmed behind the whole edit page. #}
        <div class="profile-perso__backdrop" aria-hidden="true">
            <img src="{{ personalBackground.image }}" alt=""
                 data-img-fallback="{{ personalBackground.fallback }}"
                 loading="eager" decoding="async">
        </div>
    {% else %}
        {% include 'partials/main/gradient.html.twig' %}
    {% endif %}

    <div class="relative z-10 mx-auto max-w-6xl">
        {% include 'profile/_cover.html.twig'
            with { user: user, orbSlots: orbSlots, favorites: favorites } only %}

        {# Standalone target for the favorites version picker: kept OUT of the
           autosave form (no nested forms) — the <select>/<button> in the codex
           header reach it via their HTML `form=` attribute. #}
        <form id="profile-version-form" method="post" action="{{ path('app_profile_version') }}"
              data-turbo="false" hidden aria-hidden="true">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
        </form>

        <form method="post" action="{{ path('app_profile_save') }}" data-turbo="false"
              data-autosave class="profile-layout">
            <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

            {% include 'profile/_identity_aside.html.twig' with {
                user: user, maskedEmail: maskedEmail, memberSince: memberSince
            } only %}

            {% include 'profile/_favorites_section.html.twig' with {
                slotDefs: slotDefs, pickerSlots: pickerSlots, favorites: favorites,
                user: user, versions: versions, preferredVersion: preferredVersion,
                skinBanner: skinBanner, version: version, lang: lang
            } only %}
        </form>

        <section class="profile-panel mt-14" aria-labelledby="profile-identity-title">
            <h2 id="profile-identity-title"
                class="profile-panel__title">{{ 'profile.identity.title'|trans }}</h2>
            <p class="mt-2 max-w-2xl text-sm
               text-text-muted">{{ 'profile.identity.url_warning'|trans }}</p>
            <form method="post" action="{{ path('app_profile_identity') }}" data-turbo="false"
                  class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                <label class="flex-1 sm:max-w-xs">
                    <span class="auth-label">{{ 'profile.identity.username'|trans }}</span>
                    <input type="text" name="username" value="{{ user.username }}" required
                           minlength="3" maxlength="24" autocomplete="username"
                           class="hx-input mt-1.5">
                </label>
                <label class="sm:w-40">
                    <span class="auth-label">{{ 'profile.identity.tag'|trans }}</span>
                    <span class="riot-tag mt-1.5">
                        <span class="riot-tag__prefix" aria-hidden="true">#</span>
                        <input type="text" name="riotTagline" value="{{ user.riotTagline ?? '' }}"
                               minlength="3" maxlength="5" pattern="[A-Za-z0-9]{3,5}"
                               placeholder="EUW" autocapitalize="characters" autocomplete="off"
                               class="hx-input riot-tag__input">
                    </span>
                </label>
                <button type="submit" class="hx-btn">{{ 'profile.identity.submit'|trans }}</button>
            </form>
            <p class="auth-help">{{ 'profile.identity.tag_help'|trans }}</p>
        </section>

        {% if passwordForm %}
            <section class="profile-panel mt-14" aria-labelledby="profile-password-title">
                <h2 id="profile-password-title"
                    class="profile-panel__title">{{ 'profile.password.title'|trans }}</h2>
                <p class="mt-2 max-w-2xl text-sm
                   text-text-muted">{{ 'profile.password.help'|trans }}</p>
                {{ form_start(passwordForm, {
                    action: path('app_profile_password'),
                    attr: {'data-turbo': 'false', class: 'mt-5 max-w-md space-y-5'}
                }) }}
                    {% include 'security/_password_pair.html.twig'
                        with { field: passwordForm.plainPassword } only %}
                    <button type="submit"
                            class="hx-btn">{{ 'profile.password.submit'|trans }}</button>
                {{ form_end(passwordForm) }}
            </section>
        {% endif %}

        <section class="profile-danger mt-14" aria-labelledby="profile-danger-title">
            <h2 id="profile-danger-title"
                class="profile-danger__title">{{ 'profile.danger.title'|trans }}</h2>
            <p class="mt-2 max-w-2xl text-sm text-text-muted">
                {{ (user.isGoogleAccount or not user.hasPassword
                    ? 'profile.danger.help_no_password'
                    : 'profile.danger.help')|trans }}
            </p>
            <form method="post" action="{{ path('app_profile_delete') }}" data-turbo="false"
                  class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                {% if user.isGoogleAccount %}
                    {% set confirmPhrase = 'profile.danger.confirm_phrase'|trans %}
                    <label class="flex-1 sm:max-w-xs">
                        <span class="auth-label">{{ 'profile.danger.confirm_label'|trans({
                            '%phrase%': confirmPhrase
                        }) }}</span>
                        <input type="text" name="confirmation" required
                               autocomplete="off" autocapitalize="none"
                               autocorrect="off" spellcheck="false"
                               placeholder="{{ confirmPhrase }}" class="hx-input mt-1.5">
                    </label>
                {% elseif user.hasPassword %}
                    <label class="flex-1 sm:max-w-xs">
                        <span class="auth-label">{{ 'profile.danger.password'|trans }}</span>
                        <input type="password" name="password" required
                               autocomplete="current-password" class="hx-input mt-1.5">
                    </label>
                {% endif %}
                <button type="submit"
                        class="profile-danger__btn">{{ 'profile.danger.delete'|trans }}</button>
            </form>
        </section>
    </div>
</main>
{% endblock %}
