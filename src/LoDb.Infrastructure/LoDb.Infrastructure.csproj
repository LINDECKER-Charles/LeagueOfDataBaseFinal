<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Data Protection, Identity stores and hosting abstractions come from ASP.NET Core. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="MailKit" />
    <!-- The GeoLite2 Country database of the analytics (LoDb:Analytics:GeoIpDatabase). -->
    <PackageReference Include="MaxMind.GeoIP2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      dotnet ef runs against this project alone (migrations add, migrations script): the
      design package stays private, so the API and its image never carry it.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read at run time by `migrate` and `baseline mark-applied`, in the API image too. -->
    <EmbeddedResource Include="Persistence/Baseline/*.sql" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Persistence/Baseline/*.txt" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The e-mail templates and their texts, read by the outbox when it sends. A text catalog
      is named after its locale alone (en.json): "email.fr.json" would be taken for a French
      satellite resource and leave the main assembly.
    -->
    <EmbeddedResource
      Include="Outbox/Templates/*" LogicalName="outbox.templates.%(Filename)%(Extension)" />
    <EmbeddedResource
      Include="Outbox/Texts/*.json" LogicalName="outbox.texts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoDb.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LoDb.Domain/LoDb.Domain.csproj" />
  </ItemGroup>

</Project>
