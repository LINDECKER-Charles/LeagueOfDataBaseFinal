exports[`site JSON-LD builders > links WebSite, Organization and WebPage in one graph 1`] = `
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": "https://league-of-data-base.com/#website",
      "@type": "WebSite",
      "description": "Encyclopédie League of Legends",
      "inLanguage": "fr",
      "name": "League Of Data Base",
      "publisher": {
        "@id": "https://league-of-data-base.com/#organization",
      },
      "url": "https://league-of-data-base.com/",
    },
    {
      "@id": "https://league-of-data-base.com/#organization",
      "@type": "Organization",
      "description": "Encyclopédie League of Legends",
      "logo": {
        "@id": "https://league-of-data-base.com/#logo",
        "@type": "ImageObject",
        "url": "https://league-of-data-base.com/favicon/icon-512.png",
      },
      "name": "League Of Data Base",
      "sameAs": [
        "https://github.com/LINDECKER-Charles/LeagueOfDataBaseFinal",
        "https://github.com/LINDECKER-Charles",
      ],
      "url": "https://league-of-data-base.com/",
    },
    {
      "@id": "https://league-of-data-base.com/fr/about#webpage",
      "@type": "WebPage",
      "inLanguage": "fr",
      "isPartOf": {
        "@id": "https://league-of-data-base.com/#website",
      },
      "name": "À propos — League Of Data Base",
      "url": "https://league-of-data-base.com/fr/about",
    },
  ],
}
`;

