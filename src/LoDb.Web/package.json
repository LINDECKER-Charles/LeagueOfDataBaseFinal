{
  "name": "lodb-web",
  "version": "0.0.0",
  "description": "Angular front of LeagueOfDataBase: SSR web build and static shell build.",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:web": "ng build --configuration web",
    "postbuild:web": "node src/sw/bundle-worker.mjs",
    "build:shell": "ng build --configuration shell",
    "build:shell:store": "ng build --configuration shell-store",
    "serve:ssr": "node dist/web/server/server.mjs",
    "lint": "ng lint && prettier --check . && node --test \"lint/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false",
    "api:generate": "node ../../tools/next/api/generate.mjs",
    "api:check": "node ../../tools/next/api/check.mjs",
    "i18n:convert": "node ../../tools/next/i18n/convert.mjs",
    "i18n:report": "node ../../tools/next/i18n/report.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capawesome/capacitor-app-update": "^8.0.5",
    "@capawesome/capacitor-live-update": "^8.4.4",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "ng-openapi-gen": "^1.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
