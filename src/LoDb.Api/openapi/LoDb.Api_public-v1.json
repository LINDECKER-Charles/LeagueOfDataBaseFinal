          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "champions",
                "items",
                "runes",
                "summoners"
              ],
              "type": "string"
            }
          },
          {
            "name": "range",
            "in": "query",
            "description": "The window: the last 7 or 30 UTC days, today included.",
            "schema": {
              "enum": [
                "7d",
                "30d"
              ],
              "type": "string",
