  "components": {
    "schemas": {
      "BuildItem": {
        "required": [
          "name",
          "description",
          "game_version",
          "runes",
          "steps",
          "share_url",
          "created_at"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Its title."
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "Its text as written, markup included; null when none."
          },
          "game_version": {
            "type": "string",
            "description": "The patch it was written for."
          },
          "runes": {
            "description": "The runes document, as stored.",
            "$ref": "#/components/schemas/JsonElement"
          },
          "steps": {
            "description": "The item steps, as stored.",
            "$ref": "#/components/schemas/JsonElement"
          },
          "share_url": {
            "type": "string",
            "description": "Its page on the site, absolute."
          },
          "created_at": {
            "type": "string",
            "description": "Its creation, in UTC.",
            "format": "date-time"
          }
        },
        "description": "A public build, as `/v1` lists it."
      },
      "BuildsResponse": {
        "required": [
          "champion_id",
          "data",
          "pagination"
        ],
        "type": "object",
        "properties": {
          "champion_id": {
            "type": "string",
            "description": "The champion as the path spells it."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuildItem"
            },
            "description": "The page, newest first."
          },
          "pagination": {
            "description": "Where the page stands.",
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
