# Variables of the lodb-next stack (compose.next*.yaml). Placeholder values only.
#
# Local: nothing is required, compose.next.yaml defaults every variable; override one on
# the command line (LODB_NEXT_HTTP_PORT=18180 docker compose …). The repository-root .env
# belongs to the legacy stack, and Compose reads it here too: the lodb-next variables are
# therefore prefixed (LODB_*), so that the two stacks never read each other's values.
#
# Served environment (next): the whole file, with real values, is the ENV_NEXT secret,
# written to ${NEXT_PATH}/.env by .github/workflows/next-deploy.yml
# (docs/guides/github-actions-secrets.md, section "Nouvelle stack").

# ── Project and images (served environment) ─────────────────────────────────────────
COMPOSE_PROJECT_NAME=lodb-next
REGISTRY=ghcr.io/<owner>/lodb
IMAGE_TAG=next

# ── Public hosts (served environment) ───────────────────────────────────────────────
# Labels read by the shared edge. The API subdomain must start with "api.".
CADDY_DOMAINS=next.example.com
API_CADDY_DOMAINS=api.next.example.com
# Target of the www. / .fr 301 redirects.
LODB_CANONICAL_HOST=next.example.com
# Hosts the SSR server renders for (comma-separated).
LODB_ALLOWED_HOSTS=next.example.com
# Subnet of the external edge network, the only peer trusted for X-Forwarded-For.
LODB_EDGE_CIDR=172.18.0.0/16
# 1 sends "X-Robots-Tag: noindex, nofollow" on every response (next is never indexed).
LODB_NOINDEX=1

# ── Database ────────────────────────────────────────────────────────────────────────
LODB_DB_NAME=lodb
LODB_DB_USER=lodb
# Local default: lodb. Required, strong and unique on a served environment.
LODB_DB_PASSWORD=change_me

# ── Observability ───────────────────────────────────────────────────────────────────
# OTLP endpoint of a trace collector; empty keeps the traces local (log correlation).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Local host ports (compose.next.override.yaml, plan §6.3) ───────────────────────
# Integration stack; slot 1: 18180 18181 18182 15532 18125; slot 2: 18280 18281 18282
# 15632 18225.
LODB_NEXT_HTTP_PORT=18080
LODB_NEXT_API_PORT=18081
LODB_NEXT_SSR_PORT=18082
LODB_NEXT_PG_PORT=15432
LODB_NEXT_MAIL_PORT=18025
