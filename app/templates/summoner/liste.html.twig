{# templates/summoner/liste.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ seo_title('summoner.list.title'|trans({}, 'seo')) }}{% endblock %}
{% block meta_description %}{{ 'summoner.list.description'|trans(
  {'%count%': meta.totalItem, '%version%': meta.version}, 'seo'
) }}{% endblock %}
{% block img %}/preview/summoners.png{% endblock %}

{% block structured_data %}
  {% set seoItems = [] %}
  {% for s in summoners|slice(0, 20) %}
    {% set seoItems = seoItems|merge([{
      name: s.name|default(''),
      url: seo_absolute(resource_path('app_summoner', { name: s.id|default('') }, meta.version, ''))
    }]) %}
  {% endfor %}
  {{ seo_jsonld(seo_item_list(seoItems)) }}
{% endblock %}

{% block body %}
<main class="relative px-6 py-12">
  {% include 'partials/main/gradient.html.twig' %}

  <div class="relative mx-auto max-w-[110rem]">
    <header class="mb-8">
      {% include 'components/codex/section_header.html.twig' with {
        eyebrow: 'Data Dragon · ' ~ meta.version,
        title: 'summoner.list.title'|trans,
        count: meta.totalItem,
        count_label: 'summoner.list.title'|trans|lower
      } %}
    </header>

    {% include 'components/codex/list_filter.html.twig' with { grid_id: 'summoner-grid' } %}

    <div id="summoner-grid"
         class="resource-grid grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {% for s in summoners %}
        {% set cd = s.cooldownBurn is defined and s.cooldownBurn
          ? s.cooldownBurn : (s.cooldown|default([])|join('/')) %}
        {% set modes = s.modes is defined and s.modes is iterable ? s.modes : [] %}
        {# Same curated whitelist + labels as the detail page — DDragon's raw
           list mixes in internal dev ids (WIPMODEWIP, RUBY_TRIAL_1…). #}
        {% set modeChips = game_mode_labels(modes) %}
        {% set desc = s.description is defined ? s.description : (s.tooltip|default('')) %}
        {# Facet on real game modes only — drop Data Dragon's dev/tutorial/WIP ids.
           JADE (LoL Classic) is deliberately absent: the edition facet covers it. #}
        {% set realModes = '/^(CLASSIC|ARAM|URF|SNOWURF|ARSR|ONEFORALL|NEXUSBLITZ'
            ~ '|ASSASSINATE|KINGPORO|ULTBOOK|SWIFTPLAY|BRAWL|CHERRY)$/' %}
        {% set filterModes = modes|filter(m => m matches realModes) %}
        {% embed 'components/codex/entity_card.html.twig' with {
          href: resource_path('app_summoner', { name: s.id|default('') }, meta.version, meta.lang),
          img: images[s.id|default('')]|default(null),
          name: s.name|default(''),
          sub: s.id|default(''),
          img_fit: 'contain',
          filter_text: (s.name|default('') ~ ' ' ~ s.id|default(''))|lower,
          filter_tags: filterModes,
          edition: summoner_edition(s)
        } %}
          {% block card_body %}
            <div class="px-4 pb-3">
              <div class="grid grid-cols-2 gap-2">
                <div class="stat-cell">
                  <div class="font-mono text-[10px] uppercase tracking-wider text-text-muted">{{
                    'summoner.card.cooldown'|trans }}</div>
                  <div class="mt-0.5 font-beaufort text-hex-bright">{{ cd ?: '–' }}</div>
                </div>
                <div class="stat-cell">
                  <div class="font-mono text-[10px] uppercase tracking-wider text-text-muted">{{
                    'summoner.card.level'|trans }}</div>
                  <div class="mt-0.5 font-beaufort text-text">{{ s.summonerLevel|default(0) }}</div>
                </div>
              </div>
            </div>

            {% if modeChips is not empty or desc %}
              <div class="mt-auto">
                {% if modeChips is not empty %}
                  {% embed 'components/ui/card_accordion.html.twig'
                     with { label: 'summoner.card.modes'|trans, count: modeChips|length } %}
                    {% block accordion_body %}
                      <div class="flex flex-wrap gap-1.5 px-4 pb-4">
                        {% for label in modeChips %}<span
                          class="hx-chip">{{ label }}</span>{% endfor %}
                      </div>
                    {% endblock %}
                  {% endembed %}
                {% endif %}
                {% if desc %}
                  {% embed 'components/ui/card_accordion.html.twig'
                     with { label: 'summoner.card.description'|trans } %}
                    {% block accordion_body %}
                      <div class="px-4 pb-4 text-[13px] leading-snug text-text-muted">{{
                        desc|raw }}</div>
                    {% endblock %}
                  {% endembed %}
                {% endif %}
              </div>
            {% endif %}
          {% endblock %}
        {% endembed %}
      {% else %}
        {% include 'components/ui/empty_state.html.twig' %}
      {% endfor %}
    </div>
  </div>
</main>
{% endblock %}
