{# templates/item/liste.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ seo_title('item.list.title'|trans({}, 'seo')) }}{% endblock %}
{% block meta_description %}{{ 'item.list.description'|trans(
    {'%count%': meta.totalItem, '%version%': meta.version}, 'seo'
) }}{% endblock %}
{% block img %}/preview/objects.png{% endblock %}

{% block structured_data %}
  {# First page of entries only — mirrors JsonLdBuilder::ITEM_LIST_MAX; slicing
     here skips building hundreds of throwaway Twig array merges. #}
  {% set seoItems = [] %}
  {% for id, item in items|slice(0, 20) %}
    {% set seoItems = seoItems|merge([{
      name: item.name|default(''),
      url: seo_absolute(resource_path('app_item', { name: id }, meta.version, ''))
    }]) %}
  {% endfor %}
  {{ seo_jsonld(seo_item_list(seoItems)) }}
{% endblock %}

{% block body %}
<main class="relative px-6 py-12">
  {% include 'partials/main/gradient.html.twig' %}

  <div class="relative mx-auto max-w-[110rem]">
    <header class="mb-8">
      {% include 'components/codex/section_header.html.twig' with {
        eyebrow: 'Data Dragon · ' ~ meta.version,
        title: 'item.list.header'|trans,
        count: meta.totalItem,
        count_label: 'item.list.title'|trans|lower
      } %}
    </header>

    {% include 'components/codex/list_filter.html.twig' with { grid_id: 'item-grid' } %}

    <div data-img-scope="item" data-img-version="{{ meta.version }}"
         data-img-batch="{{ image_status_batch() }}">
    {% include 'components/codex/entity_card_image.html.twig'
       with { as_template: true, img_fit: 'contain' } only %}
    <div id="item-grid"
         class="resource-grid grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {% for id, item in items %}
        {% set desc = item.plaintext is not empty
          ? item.plaintext : (item.description|default('')) %}
        {% embed 'components/codex/entity_card.html.twig' with {
          href: resource_path('app_item', { name: id }, meta.version, meta.lang),
          img: images[id]|default(null),
          img_name: item.image.full|default(null),
          name: item.name|default(''),
          sub: id,
          img_fit: 'contain',
          filter_text: (item.name|default('') ~ ' ' ~ id)|lower,
          filter_tags: item.tags is defined and item.tags is iterable ? item.tags : [],
          edition: item_edition(id)
        } %}
          {% block card_body %}
            <div class="px-4 pb-3">
              <div class="grid grid-cols-2 gap-2">
                <div class="stat-cell">
                  <div class="font-mono text-[10px] uppercase tracking-wider
                    text-text-muted">{{ 'item.list.cost_total'|trans }}</div>
                  <div class="mt-0.5 font-beaufort text-gold">{{ item.gold.total|default(0) }}</div>
                </div>
                <div class="stat-cell">
                  <div class="font-mono text-[10px] uppercase tracking-wider
                    text-text-muted">{{ 'item.list.cost_sell'|trans }}</div>
                  <div class="mt-0.5 font-beaufort text-text">{{ item.gold.sell|default(0) }}</div>
                </div>
              </div>
            </div>

            {% set tags = item.tags is defined and item.tags is iterable ? item.tags : [] %}
            {% set intoItems = item.into is defined and item.into is iterable ? item.into : [] %}
            {% if tags is not empty or intoItems is not empty or desc %}
              <div class="mt-auto">
                {% if tags is not empty %}
                  {% embed 'components/ui/card_accordion.html.twig'
                     with { label: 'item.list.categories'|trans } %}
                    {% block accordion_body %}
                      <div class="flex flex-wrap gap-1.5 px-4 pb-4">
                        {% for t in tags %}<span
                          class="hx-chip">{{ t|tag_label }}</span>{% endfor %}
                      </div>
                    {% endblock %}
                  {% endembed %}
                {% endif %}
                {% if intoItems is not empty %}
                  {% embed 'components/ui/card_accordion.html.twig'
                     with { label: 'item.list.evolutions'|trans } %}
                    {% block accordion_body %}
                      <div class="flex flex-wrap gap-2 px-4 pb-4">
                        {% for iid in intoItems %}
                          {% set child = related[iid]|default(null) %}
                          <a href="{{ resource_path('app_item', { name: iid },
                                                    meta.version, meta.lang) }}"
                             class="group/evo flex items-center gap-1.5 rounded border
                                    border-gold-deep/40 bg-void/60 px-1.5 py-1 transition-colors
                                    hover:border-gold hover:bg-void/90"
                             title="{{ child.name|default(iid) }}">
                            {% if child and child.image %}<img src="/{{ child.image }}"
                              alt="{{ child.name }}" width="24" height="24" loading="lazy"
                              decoding="async" class="hx-img h-6 w-6 object-contain">{% endif %}
                            <span class="font-mono text-xs text-text-muted
                              group-hover/evo:text-hex">{{ child.name|default(iid) }}</span>
                          </a>
                        {% endfor %}
                      </div>
                    {% endblock %}
                  {% endembed %}
                {% endif %}
                {% if desc %}
                  {% embed 'components/ui/card_accordion.html.twig'
                     with { label: 'item.list.description'|trans } %}
                    {% block accordion_body %}
                      {# ddragon_text: strips the {{ Item_* }} / @Var@ tokens Data
                         Dragon leaks in some descriptions and plaintexts. #}
                      <div class="px-4 pb-4 text-[13px] leading-snug
                        text-text-muted">{{ desc|ddragon_text|raw }}</div>
                    {% endblock %}
                  {% endembed %}
                {% endif %}
              </div>
            {% endif %}
          {% endblock %}
        {% endembed %}
      {% else %}
        {% include 'components/ui/empty_state.html.twig' %}
      {% endfor %}
    </div>
    </div>
  </div>
</main>
{% endblock %}
