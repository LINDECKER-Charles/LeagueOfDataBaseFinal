{% extends 'base.html.twig' %}

{% import 'item/_recipe_macros.html.twig' as recipe %}

{# Single source for the rendered (version, lang): PageContextResolver, the same
   resolution the controller used — never re-derived from the session here. #}
{% set selection = page_selection() %}

{% block title %}{{ seo_title(
  'item.detail.title'|trans({'%name%': item.name ?? 'Item'}, 'seo')
) }}{% endblock %}
{% block meta_description %}{{ 'item.detail.description'|trans({
  '%name%': item.name ?? 'Item',
  '%version%': selection.version
}, 'seo') }}{% endblock %}
{% block img %}/preview/objects.png{% endblock %}

{% block structured_data %}
  {{ seo_jsonld(seo_breadcrumbs([
    { name: 'header.navigation.home'|trans, url: seo_absolute(path('app_home')) },
    { name: 'header.navigation.item'|trans,
      url: seo_absolute(resource_path('app_items', {}, version|default(''), '')) },
    { name: item.name ?? '', url: seo_canonical() }
  ])) }}
  {# Gold economy + categories come straight from the item payload. #}
  {{ seo_jsonld(seo_item(
    item,
    image is defined and image ? seo_absolute('/' ~ image) : null,
    seo_canonical()
  )) }}
{% endblock %}

{% block body %}
{% set mapNames = {
  '11': "Summoner's Rift", '12': 'ARAM', '21': 'Nexus Blitz', '30': 'Arena', '35': 'Brawl'
} %}

{% set hasTree = recipeTree is defined
    and recipeTree.children is defined and recipeTree.children is not empty %}
{% set availableMaps = item.maps is defined and item.maps is iterable
    ? item.maps|filter(v => v)|keys : [] %}
{% set hasTier = item.depth is defined and item.depth > 1 %}
{% set hasRestriction = (item.requiredChampion is defined and item.requiredChampion)
    or (item.requiredAlly is defined and item.requiredAlly) %}

<main class="relative overflow-x-clip px-6 py-14">
  {% include 'partials/main/gradient.html.twig' %}

  <div class="relative mx-auto max-w-6xl">

    {# ================= Hero — the artifact on the workbench ================ #}
    <header class="detail-hero mb-14">
      {% if image %}
        <img class="detail-hero__echo" src="/{{ image }}" alt="" aria-hidden="true">
      {% endif %}

      <div class="relative flex flex-col gap-8 sm:flex-row sm:items-center">
        <div class="hextech-frame hx-corners grid h-28 w-28 shrink-0 place-items-center p-3
                    sm:h-32 sm:w-32">
          {% if image %}
            <img src="/{{ image }}" alt="{{ item.name ?? 'Item' }}"
                 class="h-full w-full object-contain">
          {% else %}
            <span class="font-beaufort text-2xl
                         text-gold/70">{{ (item.name ?? '??')|slice(0, 2)|upper }}</span>
          {% endif %}
        </div>

        <div class="min-w-0 flex-1">
          <p class="eyebrow mb-2.5">
            {{ 'item.list.title'|trans }}
            <span class="mx-2 text-gold-deep" aria-hidden="true">◆</span>
            <span class="normal-case tracking-normal font-mono text-[11px]
                         text-text-muted">{{ selection.version }} · {{ selection.lang }}</span>
          </p>
          <h1 class="hero-name text-gold-grad">{{ item.name ?? 'Item' }}</h1>
          {% if item.plaintext is defined and item.plaintext %}
            <p class="mt-2.5 max-w-[60ch] font-spiegel text-text-muted">{{ item.plaintext }}</p>
          {% endif %}
        </div>

        {# The defining metric of an item: its price in gold. #}
        {% if item.gold.total is defined %}
          <div class="shrink-0 sm:pl-4 sm:text-right">
            <p class="font-mono text-[10px] uppercase tracking-[0.2em]
                      text-text-dim">{{ 'item.detail.price_total'|trans }}</p>
            <p class="mt-1 flex items-baseline gap-2 sm:justify-end">
              <span class="font-beaufort text-5xl leading-none text-gold-grad
                           text-gold">{{ item.gold.total }}</span>
              <svg class="h-5 w-5 shrink-0 text-gold-rich" viewBox="0 0 20 20" fill="none"
                   stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="10" cy="10" r="7.5"/>
                <path d="M10 6.5v7M7.4 8.4c0-1 1.2-1.7 2.6-1.7s2.6.7 2.6 1.7c0 2.4-5.2
                         1-5.2 3.3 0 1 1.2 1.7 2.6 1.7s2.6-.7 2.6-1.7"/>
              </svg>
            </p>
            {% if item.gold.purchasable is defined and item.gold.purchasable == false %}
              <p class="mt-1.5 font-mono text-[10px] uppercase tracking-wider
                        text-text-dim">{{ 'item.detail.not_purchasable'|trans }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </header>

    {# ================= Signature : the crafting tree ======================= #}
    {% if hasTree or (related is defined and related is not empty) %}
      <section class="mb-16" data-reveal>
        {% include 'components/codex/codex_header.html.twig'
          with { title: 'item.detail.recipe'|trans } %}

        {% if hasTree %}
          <p class="eyebrow mb-5 text-center">{{ 'item.detail.builds_from'|trans }}</p>
          <div class="overflow-x-auto pb-2">
            <ul class="recipe-tree">
              {{ recipe.tree_node(recipeTree, selection.version, selection.lang, true) }}
            </ul>
          </div>
        {% endif %}

        {% if related is defined and related is not empty %}
          <div class="flex flex-col items-center gap-4
            {{ hasTree ? 'mt-10 border-t border-gold-deep/30 pt-8' : '' }}">
            <p class="eyebrow">{{ 'item.detail.evolutions'|trans }}</p>
            <div class="flex flex-wrap items-start justify-center gap-3">
              {% for child in related %}{{
                recipe.recipe_node(child, selection.version, selection.lang)
              }}{% endfor %}
            </div>
          </div>
        {% endif %}
      </section>
    {% endif %}

    {# ================= Codex spread : description + artifact aside ========= #}
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-12">
      <div>
        {% if item.description is defined and item.description %}
          <section data-reveal>
            {% include 'components/codex/codex_header.html.twig'
              with { title: 'item.detail.description'|trans } %}
            <div class="hextech-frame hx-corners p-7 sm:p-8">
              {# DDragon's own localized markup (<stats>/<passive>/<active>…),
                 styled by .ddragon-rich — the canonical, translated stat sheet. #}
              <div class="ddragon-rich max-w-[68ch]">{{ item.description|ddragon_text|raw }}</div>
            </div>
          </section>
        {% endif %}
      </div>

      {% include 'item/_aside.html.twig' with {
        item: item, availableMaps: availableMaps, hasTier: hasTier,
        hasRestriction: hasRestriction, mapNames: mapNames
      } only %}
    </div>

    {% include 'components/codex/detail_pager.html.twig' with {
      nav: nav|default({ prev: null, next: null }),
      route: 'app_item',
      list_href: resource_path('app_items', {}, selection.version, selection.lang),
      version: selection.version,
      lang: selection.lang
    } %}
    {% include 'components/codex/detail_actions.html.twig' %}
  </div>
</main>
{% endblock %}
