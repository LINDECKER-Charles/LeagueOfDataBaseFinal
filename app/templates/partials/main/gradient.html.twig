{# Ambient backdrop — glows + a woven texture + vignette. Included by
   list/detail/home pages, so restyling it here upgrades them all.

   The weave is the one piece of atmosphere CSS alone cannot theme, because the
   four identities need different GEOMETRY, not a different colour. All four
   patterns ship and the theme shows one:

     hexweave   Piltover's hex crystal, drawn with a compass
     ironlattice Zaun's Art Nouveau grille — ogee arcs and a whiplash stem
     chevron    Noxus — scale armour, the crest's downward point as a field
     seigaiha   Spirit Blossom — overlapping arcs, the abstract cloud Riot's own
                art direction uses in place of anything literally Japanese

   Rendering all four rather than picking one server-side is what keeps the
   client toggle instant: a pattern whose <rect> is display:none is never
   rasterised, so the three inactive ones cost nothing but markup. #}
<div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
  <div class="hx-ambient-glow--cyan hx-breathe absolute -top-1/3 left-1/2 h-[62rem] w-[62rem]
              rounded-full blur-3xl"></div>
  <div class="hx-ambient-glow--gold absolute right-0 top-1/4 h-[34rem] w-[34rem] rounded-full
              opacity-20 blur-3xl"></div>

  <svg class="absolute inset-0 h-full w-full opacity-[0.05]" aria-hidden="true">
    <defs>
      <pattern id="hexweave" width="56" height="48" patternUnits="userSpaceOnUse">
        <path d="M14 1 L42 1 L56 24 L42 47 L14 47 L0 24 Z"
              fill="none" stroke="var(--color-gold)" stroke-width="1"/>
      </pattern>
      {# Ogee lattice: half-arcs that continue into the neighbouring tile at
         mid-height so the grille runs unbroken, plus the whiplash stem.
         Tall tile — Zaun is read vertically. #}
      <pattern id="ironlattice" width="60" height="104" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="var(--color-gold)" stroke-width="1">
          <path d="M30 0 C48 16 60 32 60 52 C60 72 48 88 30 104"/>
          <path d="M30 0 C12 16 0 32 0 52 C0 72 12 88 30 104"/>
          <path d="M30 20 C22 34 38 44 30 52 C22 60 38 70 30 84" opacity="0.7"/>
        </g>
      </pattern>
      {# Chevron courses — the crest's point, repeated into a field of scales. #}
      <pattern id="chevron" width="48" height="24" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="var(--color-gold)" stroke-width="1">
          <path d="M0 3 L24 19 L48 3"/>
          <path d="M0 11 L24 27 L48 11" opacity="0.55"/>
        </g>
      </pattern>
      {# Seigaiha — two staggered courses of concentric arcs. The offset row is
         drawn beyond the tile edges on purpose; the pattern clips it, and that
         clipping is what makes the courses interlock. #}
      <pattern id="seigaiha" width="40" height="20" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="var(--color-gold)" stroke-width="1">
          <path d="M0 20 A20 20 0 0 1 40 20"/>
          <path d="M7 20 A13 13 0 0 1 33 20" opacity="0.65"/>
          <path d="M-20 10 A20 20 0 0 1 20 10"/>
          <path d="M-13 10 A13 13 0 0 1 13 10" opacity="0.65"/>
          <path d="M20 10 A20 20 0 0 1 60 10"/>
          <path d="M27 10 A13 13 0 0 1 53 10" opacity="0.65"/>
        </g>
      </pattern>
    </defs>
    <rect class="weave-hex" width="100%" height="100%" fill="url(#hexweave)"/>
    <rect class="weave-iron" width="100%" height="100%" fill="url(#ironlattice)"/>
    <rect class="weave-chevron" width="100%" height="100%" fill="url(#chevron)"/>
    <rect class="weave-seigaiha" width="100%" height="100%" fill="url(#seigaiha)"/>
  </svg>

  <div class="hx-ambient-vignette absolute inset-0"></div>
</div>
