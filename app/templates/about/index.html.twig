{% extends 'about/layout.html.twig' %}

{% block title %}{{ seo_title('about.title'|trans({}, 'seo')) }}{% endblock %}
{% block meta_description %}{{ 'about.description'|trans({}, 'seo') }}{% endblock %}
{% block img %}/preview/home.png{% endblock %}

{% block structured_data %}
  {{ seo_jsonld(seo_breadcrumbs([
    { name: 'header.navigation.home'|trans, url: seo_absolute(path('app_home')) },
    { name: 'index.title'|trans({}, 'about'), url: seo_canonical() }
  ])) }}
  {{ seo_jsonld(seo_about_page({
    name: 'index.title'|trans({}, 'about'),
    url: seo_canonical(),
    description: 'about.description'|trans({}, 'seo'),
    inLanguage: app.request.locale
  })) }}
{% endblock %}

{% block page_title %}{{ 'index.title'|trans({}, 'about') }}{% endblock %}
{% block page_lead %}{{ 'index.lead'|trans({}, 'about') }}{% endblock %}

{% block about_body %}
{# Feature ids listed here drive both the headings and their copy — the catalog
   holds index.features.<id>.title / .body for each. #}
{% set features = ['codex', 'patches', 'languages', 'builds', 'trends', 'api', 'offline'] %}

<section id="what">
  {% include 'components/codex/codex_header.html.twig'
     with { title: 'index.what.title'|trans({}, 'about') } %}
  <p>{{ 'index.what.body'|trans({}, 'about') }}</p>

  <div class="about-facts">
    <div class="about-fact">
      <span class="about-fact__value">{{ inventory.champions ?? '—' }}</span>
      <span class="about-fact__label">{{ 'header.navigation.champion'|trans }}</span>
    </div>
    <div class="about-fact">
      <span class="about-fact__value">{{ inventory.items ?? '—' }}</span>
      <span class="about-fact__label">{{ 'header.navigation.item'|trans }}</span>
    </div>
    <div class="about-fact">
      <span class="about-fact__value">{{ inventory.runes ?? '—' }}</span>
      <span class="about-fact__label">{{ 'header.navigation.runes'|trans }}</span>
    </div>
    <div class="about-fact">
      <span class="about-fact__value">{{ inventory.summoners ?? '—' }}</span>
      <span class="about-fact__label">{{ 'header.navigation.summoner'|trans }}</span>
    </div>
  </div>
</section>

<hr class="hx-rule">

<section id="audience">
  {% include 'components/codex/codex_header.html.twig'
     with { title: 'index.audience.title'|trans({}, 'about') } %}
  <p>{{ 'index.audience.body'|trans({}, 'about') }}</p>
</section>

<hr class="hx-rule">

<section id="features">
  {% include 'components/codex/codex_header.html.twig'
     with { title: 'index.features.title'|trans({}, 'about') } %}
  {% for feature in features %}
    <h3>{{ ('index.features.' ~ feature ~ '.title')|trans({}, 'about') }}</h3>
    <p>{{ ('index.features.' ~ feature ~ '.body')|trans({}, 'about') }}</p>
  {% endfor %}
</section>

<hr class="hx-rule">

<section id="data">
  {% include 'components/codex/codex_header.html.twig'
     with { title: 'index.data.title'|trans({}, 'about') } %}
  <p>{{ 'index.data.body'|trans({}, 'about') }}</p>
  <p><a href="{{ path('app_about_data') }}">{{ 'index.data.link'|trans({}, 'about') }}</a></p>
</section>

<hr class="hx-rule">

<section id="who">
  {% include 'components/codex/codex_header.html.twig'
     with { title: 'index.who.title'|trans({}, 'about') } %}
  <p>{{ 'index.who.body'|trans({}, 'about') }}</p>
  <p>{{ 'index.who.opensource'|trans({}, 'about') }}
    <a href="https://github.com/LINDECKER-Charles/LeagueOfDataBaseFinal"
       target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
</section>

<hr class="hx-rule">

<section id="more">
  {% include 'components/codex/codex_header.html.twig'
     with { title: 'index.more.title'|trans({}, 'about') } %}
  <ul>
    <li><a href="{{ path('app_faq') }}">{{ 'faq.title'|trans({}, 'about') }}</a></li>
    <li><a href="{{ path('app_about_data') }}">{{ 'data.title'|trans({}, 'about') }}</a></li>
    <li><a href="{{ path('app_developers') }}">{{ 'nav.developers'|trans({}, 'api') }}</a></li>
    <li><a href="{{ path('app_changelog') }}">{{ 'changelog.title'|trans }}</a></li>
    <li><a href="{{ path('app_legal_notice') }}">{{ 'legal.notice.title'|trans }}</a></li>
  </ul>
</section>
{% endblock %}
