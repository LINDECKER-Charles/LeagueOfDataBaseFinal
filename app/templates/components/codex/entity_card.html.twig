{# Embeddable Hextech card shell — factors out the frame/header/footer shared by
   the champion / item / summoner / rune cards. Fill {% block card_body %} in the caller.
   Params: href, img, name, sub, initials, img_fit ('cover'|'contain'), img_scale, img_round,
   footer_href, footer_label
   img_round renders the icon as a circle (rune tree marks — the "focus" glyph).
   Filtering (optional): filter_text (searchable string), filter_tags (list), edition
   ('modern'|'classic') — read by the ResourceFilter island to search/facet the grid
   client-side; the edition also marks the card (LoL Classic badge).
   Cold images: img_name (image file name) + the `pending` map of the list render
   turn a missing `img` into a refreshable slot instead of plain initials. #}
{% set img_pending = img|default(null) is empty
    and img_name|default(null) is not empty
    and (pending|default({}))[img_name] is defined %}
<section class="hextech-frame hextech-frame-hover group flex h-full flex-col overflow-hidden"
  {% if filter_text is defined %}data-search="{{ filter_text }}"{% endif %}
  {% if filter_tags is defined %}data-tags="{{ filter_tags|join('|') }}"{% endif %}
  {% if edition is defined %}data-edition="{{ edition }}"{% endif %}>
  <a href="{{ href|default('#') }}" class="flex items-center gap-3 px-4 pb-3 pt-4">
    {% include 'components/codex/entity_card_image.html.twig' with {
      img: img|default(null),
      pending: img_pending,
      img_name: img_name|default(''),
      name: name,
      initials: initials|default(name|slice(0, 2)|upper),
      img_fit: img_fit|default('cover'),
      img_scale: img_scale|default(null),
      img_round: img_round|default(false)
    } only %}
    <div class="min-w-0">
      <h3 class="truncate font-beaufort text-[15px] tracking-wide text-text transition-colors
                 group-hover:text-gold-bright" title="{{ name }}">{{ name }}</h3>
      <div class="flex min-w-0 items-center gap-2">
        {% if sub %}<p class="truncate font-mono text-xs text-text-muted"
          title="{{ sub }}">{{ sub }}</p>{% endif %}
        {% include 'components/codex/edition_badge.html.twig' with {
          edition: edition|default('modern'), class: 'px-1.5 py-0.5 text-[9px]'
        } only %}
      </div>
    </div>
  </a>

  {% block card_body %}{% endblock %}

  {% if footer_label is defined %}
    <footer class="mt-auto gold-rule">
      <a href="{{ footer_href|default(href) }}"
         class="block py-2.5 text-center font-beaufort text-xs uppercase tracking-[0.2em]
                text-gold/80 transition-colors hover:text-gold-bright">
        {{ footer_label }}
      </a>
    </footer>
  {% endif %}
</section>
