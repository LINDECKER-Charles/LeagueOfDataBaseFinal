{# Client-side grid filter bar: live search, per-category facets (schema from
   facet_schema(), values as data-f-* on the cards), pagination — all mirrored
   in the URL so a filtered list can be shared. The ResourceFilter island drives
   the sibling grid `#{{ grid_id }}`.
   Params: grid_id (required), facet_type (required — the schema's resource
   type), page_size (optional). #}
<div class="mb-8 flex flex-col gap-3">
  <div class="min-w-0 flex-1" data-vue="resource-filter" data-props="{{ {
        gridId: grid_id,
        placeholder: 'common.search'|trans,
        pageSize: page_size|default(12),
        facets: facet_schema(facet_type),
        labels: {
          results: 'filter.results'|trans,
          empty: 'filter.empty'|trans,
          clear: 'filter.clear'|trans,
          prev: 'filter.prev'|trans,
          next: 'filter.next'|trans,
          perPage: 'filter.per_page'|trans,
          all: 'filter.all'|trans,
          filters: 'filter.filters'|trans,
          close: 'filter.close'|trans,
          advanced: 'filter.advanced'|trans,
          matchAny: 'filter.match_any'|trans,
          matchAll: 'filter.match_all'|trans,
          min: 'filter.min'|trans,
          max: 'filter.max'|trans,
          copy: 'filter.copy_link'|trans,
          copied: 'filter.copied'|trans,
          copyError: 'filter.copy_error'|trans,
          active: 'filter.active'|trans
        }
      }|json_encode|e('html_attr') }}">{% include 'components/ui/skeleton.html.twig'
        with { kind: 'filter' } only %}</div>
</div>
