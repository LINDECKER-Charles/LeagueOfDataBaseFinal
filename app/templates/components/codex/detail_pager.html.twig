{# The codex turns its own pages — previous / next entity in collection order,
   with the diamond hub linking back to the list. Params: nav {prev,next} (each
   {id, name, edition?}), route (detail route name), list_href, version, lang.
   A neighbour from the LoL Classic edition is badged: its name alone repeats a
   current entry's. #}
<nav class="pager mt-14" aria-label="{{ 'detail.nav.label'|trans }}">
  {% if nav.prev|default(null) %}
    <a class="pager__link" rel="prev"
       href="{{ resource_path(route, { name: nav.prev.id }, version, lang) }}">
      <span class="pager__eyebrow">‹ {{ 'detail.nav.previous'|trans }}</span>
      <span class="pager__name">{{ nav.prev.name }}
        {% include 'components/codex/edition_badge.html.twig' with {
          edition: nav.prev.edition|default('modern'), class: 'ml-2 px-1.5 py-0.5 text-[9px]'
        } only %}</span>
    </a>
  {% else %}
    <span aria-hidden="true"></span>
  {% endif %}

  <a class="pager__hub" href="{{ list_href }}" title="{{ 'detail.nav.back_to_list'|trans }}">
    <span class="sr-only">{{ 'detail.nav.back_to_list'|trans }}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
         aria-hidden="true">
      <rect x="5" y="5" width="14" height="14"/><rect x="9.5" y="9.5" width="5" height="5"/>
    </svg>
  </a>

  {% if nav.next|default(null) %}
    <a class="pager__link pager__link--next" rel="next"
       href="{{ resource_path(route, { name: nav.next.id }, version, lang) }}">
      <span class="pager__eyebrow">{{ 'detail.nav.next'|trans }} ›</span>
      <span class="pager__name">{{ nav.next.name }}
        {% include 'components/codex/edition_badge.html.twig' with {
          edition: nav.next.edition|default('modern'), class: 'ml-2 px-1.5 py-0.5 text-[9px]'
        } only %}</span>
    </a>
  {% else %}
    <span aria-hidden="true"></span>
  {% endif %}
</nav>
