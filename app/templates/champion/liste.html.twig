{# templates/champion/liste.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ seo_title('champion.list.title'|trans({}, 'seo')) }}{% endblock %}
{% block meta_description %}{{ 'champion.list.description'|trans(
  {'%count%': meta.totalItem, '%version%': meta.version}, 'seo'
) }}{% endblock %}
{% block img %}/preview/champions.png{% endblock %}

{% block structured_data %}
  {# First page of entries only — mirrors JsonLdBuilder::ITEM_LIST_MAX; slicing
     here skips building hundreds of throwaway Twig array merges. #}
  {% set seoItems = [] %}
  {% for c in champions|slice(0, 20) %}
    {% set seoItems = seoItems|merge([{
      name: c.name|default(''),
      url: seo_absolute(
        resource_path('app_champion', { name: c.id|default(c.name) }, meta.version, '')
      )
    }]) %}
  {% endfor %}
  {{ seo_jsonld(seo_item_list(seoItems)) }}
{% endblock %}

{% block body %}
{# Champion portrait art is hotlinked from the DDragon CDN (assumed, like the
   champion detail hero) — not the ingested square icons. #}
<main class="relative px-6 py-12">
  {% include 'partials/main/gradient.html.twig' %}

  <div class="relative mx-auto max-w-[110rem]">
    <header class="mb-8">
      {% include 'components/codex/section_header.html.twig' with {
        eyebrow: 'Data Dragon · ' ~ meta.version,
        title: 'champion.list.title'|trans,
        count: meta.totalItem,
        count_label: 'champion.list.title'|trans|lower
      } %}
    </header>

    {% include 'components/codex/list_filter.html.twig'
       with { grid_id: 'champion-grid', facet_type: 'champion' } %}

    {# Versioned square icon (ingested per patch), overlaid on the unversioned
       splash so the art carries a version-accurate cue — a refreshable slot
       while cold (see components/ui/resource_image). #}
    {% set overlayBox = 'absolute bottom-2 left-2 h-10 w-10 border border-gold/60 bg-void shadow-[0_2px_10px_rgba(1,10,19,0.75)]' %}
    <div data-img-scope="champion" data-img-version="{{ meta.version }}"
         data-img-batch="{{ image_status_batch() }}">
    {% include 'components/ui/resource_image_template.html.twig' with {
      box_class: overlayBox, img_class: 'h-full w-full object-cover', size: 40
    } only %}
    <div id="champion-grid"
         class="resource-grid grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {% for c in champions %}
        {% set champId = c.id|default(c.name) %}
        {% set champIcon = images[champId]|default(null) %}
        {% set champIconName = c.image.full|default(null) %}
        {% set champIconPending = champIcon is empty and champIconName is not empty
          and pending[champIconName] is defined %}
        <a href="{{ resource_path('app_champion', { name: champId }, meta.version, meta.lang) }}"
           class="hextech-frame hextech-frame-hover group flex h-full flex-col overflow-hidden"
           data-search="{{ (c.name|default('') ~ ' ' ~ c.id|default(''))|lower }}"
           {{ facet_attrs('champion', champId, c) }}>
          <div class="relative aspect-[4/5] overflow-hidden border-b border-gold-deep/50 bg-void">
            <span aria-hidden="true" class="hatch-gold absolute inset-0"></span>
            <span aria-hidden="true"
                  class="absolute inset-0 grid place-items-center font-beaufort text-6xl
                         text-gold/12">{{ c.name|default('??')|slice(0, 2)|upper }}</span>
            <img src="{{ champion_art(champId, 'loading') }}" alt="{{ c.name|default('') }}"
                 loading="lazy" decoding="async"
                 class="hx-img relative h-full w-full object-cover object-top transition-transform
                        duration-500 group-hover:scale-105">
            {% if champIcon or champIconPending %}
              {% include 'components/ui/resource_image.html.twig' with {
                src: champIcon, pending: champIconPending, name: champIconName,
                alt: '', initials: '', box_class: overlayBox,
                img_class: 'h-full w-full object-cover', size: 40
              } only %}
            {% endif %}
          </div>
          <div class="flex flex-1 flex-col p-4">
            <h3 class="truncate font-beaufort text-[15px] tracking-wide text-gold-grad"
                title="{{ c.name|default('') }}">{{ c.name|default('') }}</h3>
            {% if c.title|default('') %}<p class="mt-0.5 truncate font-spiegel text-xs
              text-text-muted">{{ c.title|ucfirst }}</p>{% endif %}
            {% if c.tags is defined and c.tags is not empty %}
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {% for t in c.tags %}<span class="hx-chip">{{ t }}</span>{% endfor %}
              </div>
            {% endif %}
            {% if c.blurb is defined and c.blurb %}
              <p class="mt-2 line-clamp-2 text-[13px] leading-snug
                 text-text-muted">{{ c.blurb }}</p>
            {% endif %}
            <span class="mt-auto inline-flex items-center gap-2 pt-3 font-beaufort text-xs
                         uppercase tracking-[0.14em] text-gold transition-colors
                         group-hover:text-hex">
              {{ 'common.detail'|trans }}
              <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
                   viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      {% else %}
        {% include 'components/ui/empty_state.html.twig' %}
      {% endfor %}
    </div>
    </div>
  </div>
</main>
{% endblock %}
