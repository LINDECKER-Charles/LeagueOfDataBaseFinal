{# templates/champion/detail.html.twig #}
{% extends 'base.html.twig' %}

{# Single source for the rendered (version, lang): PageContextResolver, the same
   resolution the controller used — never re-derived from the session here. #}
{% set selection = page_selection() %}

{% block title %}{{ seo_title(
  'champion.detail.title'|trans({'%name%': champion.name ?? 'Champion'}, 'seo')
) }}{% endblock %}
{% block meta_description %}{{ 'champion.detail.description'|trans({
  '%name%': champion.name ?? 'Champion',
  '%version%': selection.version
}, 'seo') }}{% endblock %}
{% block img %}/preview/champions.png{% endblock %}

{% block structured_data %}
  {{ seo_jsonld(seo_breadcrumbs([
    { name: 'header.navigation.home'|trans, url: seo_absolute(path('app_home')) },
    {
      name: 'header.navigation.champion'|trans,
      url: seo_absolute(resource_path('app_champions', {}, version|default(''), ''))
    },
    { name: champion.name ?? '', url: seo_canonical() }
  ])) }}
  {# Full entity: role tags, resource, Riot profile ratings and base stats are
     projected from the champion payload itself (see GameEntityJsonLd). #}
  {{ seo_jsonld(seo_champion(
    champion,
    image is defined and image ? seo_absolute('/' ~ image) : null,
    seo_canonical()
  )) }}
{% endblock %}

{% block body %}
{% set champId = champion.id ?? champion.key %}
{% set splashBase = 'https://ddragon.leagueoflegends.com/cdn/img/champion/splash' %}

{# ---- Ability view-model: P + Q/W/E/R, shared by the showcase island and its
   no-JS fallback. Descriptions keep DDragon's localized markup (cleaned of
   leaked template tokens); tooltips are deliberately ignored — their {{ }}
   placeholders have no resolvable values in Data Dragon. #}
{% set abilities = [] %}
{% if champion.passive is defined %}
  {% set pImg = abilityImages[champion.passive.image.full ?? '']|default(null) %}
  {% set abilities = abilities|merge([{
    key: 'P',
    name: champion.passive.name,
    description: champion.passive.description|default('')|ddragon_text,
    icon: pImg ? '/' ~ pImg : null,
    cooldown: null, cost: null, range: null, maxrank: null, charges: null
  }]) %}
{% endif %}
{% set slotKeys = ['Q', 'W', 'E', 'R'] %}
{% for spell in champion.spells|default([]) %}
  {% set sImg = abilityImages[spell.image.full ?? '']|default(null) %}
  {% set ammo = (spell.maxammo|default(-1)) + 0 %}
  {# DDragon range sentinels: "self" and huge values (25000+, incl. the uint32
     "-1" 4294967295) are placeholders, not measurable ranges — Aatrox Q says
     25000 while Jhin R says it too. No chip beats a made-up number. #}
  {% set rawRange = spell.rangeBurn|default(null) %}
  {% set range = rawRange and rawRange != 'self'
      and (rawRange|split('/')|first + 0) < 25000 ? rawRange : null %}
  {% set abilities = abilities|merge([{
    key: slotKeys[loop.index0]|default('R'),
    name: spell.name,
    description: spell.description|default('')|ddragon_text,
    icon: sImg ? '/' ~ sImg : null,
    cooldown: spell.cooldownBurn|default(null),
    cost: spell.costBurn|default(null),
    range: range,
    maxrank: spell.maxrank|default(null),
    charges: ammo > 0 ? ammo : null
  }]) %}
{% endfor %}

{# ---- Skins view-model (chroma-skins are filtered server-side) ------------- #}
{% set skinData = [] %}
{% if champId and champion.skins is defined %}
  {% for skin in champion.skins %}
    {% set skinNum = skin.num ?? loop.index0 %}
    {% if skinNum != 0 %}
      {% set skinId = skin.id ?? null %}
      {% set skinData = skinData|merge([{
        num: skinNum,
        name: skin.name == 'default' ? champion.name : skin.name,
        splash: splashBase ~ '/' ~ champId ~ '_' ~ skinNum ~ '.jpg',
        chromas: skinId ? (chromas[skinId] ?? []) : []
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set lore = champion.lore|default(champion.blurb) %}
{% set ally = champion.allytips|default([])|filter(t => t is not empty) %}
{% set enemy = champion.enemytips|default([])|filter(t => t is not empty) %}

<main class="relative">
  {# ================= Hero — cinematic centered splash ==================== #}
  {% include 'champion/_hero.html.twig' with {
    champion: champion, champId: champId,
    heroArt: heroArt, selection: selection
  } only %}

  {# ================= Sticky in-page section nav =========================== #}
  <nav class="section-nav" aria-label="{{ 'detail.nav.sections'|trans }}" data-scrollspy>
    {% if abilities is not empty %}<a href="#abilities">{{
      'champion.detail.abilities'|trans }}</a>{% endif %}
    {% if skinData is not empty %}<a href="#skins">{{
      'champion.detail.skins'|trans }}</a>{% endif %}
    {% if lore %}<a href="#lore">{{ 'champion.detail.lore.title'|trans }}</a>{% endif %}
    {% if ally is not empty or enemy is not empty %}<a href="#tips">{{
      'champion.detail.tips'|trans }}</a>{% endif %}
    {% if champion.stats is defined %}<a href="#stats">{{
      'champion.detail.stats.title'|trans }}</a>{% endif %}
  </nav>

  {# ================= Codex spread : main column + artifact aside ========== #}
  <div class="relative px-6 py-14">
    {% include 'partials/main/gradient.html.twig' %}

    <div class="relative mx-auto max-w-7xl lg:grid lg:grid-cols-[minmax(0,1fr)_21rem]
         lg:items-start lg:gap-12">
      <div class="space-y-16">

        {# ---- Signature : the ability showcase --------------------------- #}
        {% if abilities is not empty %}
          {% include 'champion/_abilities.html.twig'
             with { champion: champion, abilities: abilities } only %}
        {% endif %}

        {# ---- Skins ------------------------------------------------------- #}
        {% if skinData is not empty %}
          <section id="skins" data-reveal>
            {% include 'components/codex/codex_header.html.twig' with {
              title: 'champion.detail.skins'|trans,
              meta: skinData|length
            } %}
            <div data-vue="skin-gallery" data-vue-lazy
                 data-props="{{ {
                   championName: champion.name,
                   skins: skinData
                 }|json_encode|e('html_attr') }}">{% include
                   'components/ui/skeleton.html.twig' with { kind: 'gallery' } only %}</div>
          </section>
        {% endif %}

        {# ---- Lore -------------------------------------------------------- #}
        {% if lore %}
          <section id="lore" data-reveal>
            {% include 'components/codex/codex_header.html.twig'
               with { title: 'champion.detail.lore.title'|trans } %}
            <div class="hextech-frame hx-corners p-7 sm:p-9">
              <div class="ddragon-rich ddragon-rich--lore max-w-[65ch]">{{
                lore|ddragon_text|raw }}</div>
            </div>
          </section>
        {% endif %}

        {# ---- Tips ---------------------------------------------------------- #}
        {% if ally is not empty or enemy is not empty %}
          <section id="tips" data-reveal>
            {% include 'components/codex/codex_header.html.twig'
               with { title: 'champion.detail.tips'|trans } %}
            <div class="grid gap-6 md:grid-cols-2">
              {% if ally is not empty %}
                <div class="hextech-frame p-6">
                  <h3 class="mb-4 font-beaufort text-sm uppercase tracking-[0.2em] text-gold">{{
                    'champion.detail.tips_as'|trans }}</h3>
                  <ul class="space-y-2.5 text-sm text-text-muted">
                    {% for tip in ally %}<li class="border-l-2 border-gold-deep pl-3">{{
                      tip }}</li>{% endfor %}
                  </ul>
                </div>
              {% endif %}
              {% if enemy is not empty %}
                <div class="hextech-frame p-6">
                  <h3 class="mb-4 font-beaufort text-sm uppercase tracking-[0.2em]
                      text-danger-light">{{ 'champion.detail.tips_against'|trans }}</h3>
                  <ul class="space-y-2.5 text-sm text-text-muted">
                    {% for tip in enemy %}<li class="border-l-2 border-danger-strong/60 pl-3">{{
                      tip }}</li>{% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
          </section>
        {% endif %}
      </div>

      {# ---- Artifact aside : statistics + level scaling ------------------- #}
      {% if champion.stats is defined %}
        {% include 'champion/_stats_aside.html.twig' with {
          champion: champion, image: image|default(null), selection: selection
        } only %}
      {% endif %}
    </div>

    <div class="relative mx-auto max-w-7xl">
      {% include 'components/codex/detail_pager.html.twig' with {
        nav: nav|default({ prev: null, next: null }),
        route: 'app_champion',
        list_href: resource_path('app_champions', {}, selection.version, selection.lang),
        version: selection.version,
        lang: selection.lang
      } %}
      {% include 'components/codex/detail_actions.html.twig' %}
    </div>
  </div>
</main>
{% endblock %}
