# Test env defaults (committed, NON-secret). APP_ENV=test is forced by phpunit.dist.xml.
#
# Every value here is deliberately fake and carries no security meaning: the suite must
# boot on a bare clone, with no secret provisioned. Real test-env values (MINIO_*,
# DATABASE_URL, STRIPE_*) come from app/.env.test.local (git-ignored), written in CI from
# the ENV_TEST GitHub secret. See docs/guides/github-actions-secrets.md.
#
# Keep these non-empty. An empty value here does not "fall back" to anything — it *is*
# the resolved env var, and several of them fail closed (see below).

KERNEL_CLASS='App\Kernel'

# Seeds the remember-me signature on the `main` firewall. Empty makes SignatureHasher
# throw at container build time, so every page under `main` 500s before reaching a test.
APP_SECRET=test-not-a-real-secret

# Admin panel credentials used by the functional tests (App\Security\AdminAuthenticator).
# Empty makes the login assertion vacuous: the authenticator compares with hash_equals(),
# and hash_equals('', '') is true, so an empty password authenticates against itself.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=test-not-a-real-password
