{
  "title": "Rate limit burst, then quota -> credits -> quota_exceeded",
  "steps": [
    { "id": "burst", "note": "10 per minute: the 11th request of the burst is refused", "repeat": 11, "request": { "method": "GET", "path": "/v1/trends/champions", "headers": { "X-Api-Key": "{{key:burst}}" } } },
    { "id": "burst-usage", "note": "/v1/usage is rate-limited too", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:burst}}" } } },
    { "id": "burst-invalid-route-params", "note": "the limiter runs before the handler validates anything", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=0", "headers": { "X-Api-Key": "{{key:burst}}" } } },
    { "id": "burst-options", "request": { "method": "OPTIONS", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:burst}}" } } },

    { "id": "quota-chain", "note": "499/500 used and 2 credits: plan, credit, credit, then quota_exceeded", "repeat": 4, "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "X-Api-Key": "{{key:quota_edge}}" } } },
    { "id": "wait-for-metering", "action": "sleep", "ms": 1500 },
    { "id": "quota-chain-usage", "note": "requests paid by credits are metered too", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:quota_edge}}" } } },

    { "id": "exhausted-no-credits", "request": { "method": "GET", "path": "/v1/trends/items", "headers": { "Authorization": "Bearer {{key:quota_exhausted}}" } } },
    { "id": "exhausted-invalid-params", "note": "the quota is checked before the parameters", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=0", "headers": { "Authorization": "Bearer {{key:quota_exhausted}}" } } },
    { "id": "exhausted-usage", "note": "/v1/usage stays reachable on an exhausted key", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer {{key:quota_exhausted}}" } } }
  ]
}
