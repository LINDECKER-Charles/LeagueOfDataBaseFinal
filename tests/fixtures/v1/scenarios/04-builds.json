{
  "title": "Champion builds: pagination, per_page cap, invalid parameters, ordering, visibility",
  "steps": [
    { "id": "default-page", "note": "page 1, 20 per page; newest first, ties by id descending", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "page-3", "note": "last page: 17 of 57", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=3", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "page-beyond-last", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=4", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "per-page-50", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=2&per_page=50", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "per-page-51-capped", "note": "above 50 is clamped, not rejected", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=2&per_page=51", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "per-page-1000-capped", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=2&per_page=1000", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "last-partial-page", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=12&per_page=5", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "leading-zeros", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=02&per_page=03", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "plus-sign", "note": "strconv.Atoi accepts a leading +", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=%2B2&per_page=2", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "repeated-parameter", "note": "the first value wins", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?per_page=2&per_page=9&page=1", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "empty-parameters", "note": "empty values fall back to the defaults", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=&per_page=", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "page-zero", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=0", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "page-negative", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=-1", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "page-not-a-number", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?page=abc", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "per-page-zero", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?per_page=0", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "per-page-decimal", "request": { "method": "GET", "path": "/v1/champions/Aatrox/builds?per_page=2.5", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "unknown-champion", "note": "no validation of the id: an empty page", "request": { "method": "GET", "path": "/v1/champions/NotAChampion/builds", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "champion-id-case", "note": "exact match on champion_id", "request": { "method": "GET", "path": "/v1/champions/aatrox/builds", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "ahri", "note": "raw runes/steps JSON, HTML and non-ASCII text, a public build of a private profile", "request": { "method": "GET", "path": "/v1/champions/Ahri/builds", "headers": { "X-Api-Key": "{{key:credits}}" } } },
    { "id": "missing-champion-segment", "request": { "method": "GET", "path": "/v1/champions//builds", "headers": { "X-Api-Key": "{{key:credits}}" } } }
  ]
}
