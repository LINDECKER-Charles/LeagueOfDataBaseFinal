{
  "title": "CORS pre-flight, /healthz, unknown routes and methods (Go's plain-text 404/405)",
  "steps": [
    { "id": "options-usage-no-key", "request": { "method": "OPTIONS", "path": "/v1/usage" } },
    { "id": "options-preflight", "request": { "method": "OPTIONS", "path": "/v1/profiles/PublicPlayer", "headers": { "Origin": "https://client.example", "Access-Control-Request-Method": "GET", "Access-Control-Request-Headers": "authorization" } } },
    { "id": "options-unknown-v1-route", "request": { "method": "OPTIONS", "path": "/v1/nothing-here" } },
    { "id": "options-healthz", "request": { "method": "OPTIONS", "path": "/healthz" } },
    { "id": "healthz", "request": { "method": "GET", "path": "/healthz" } },
    { "id": "healthz-with-key", "request": { "method": "GET", "path": "/healthz", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "root", "request": { "method": "GET", "path": "/" } },
    { "id": "v1-without-slash", "request": { "method": "GET", "path": "/v1" } },
    { "id": "v1-root", "request": { "method": "GET", "path": "/v1/" } },
    { "id": "unknown-v1-route-no-key", "request": { "method": "GET", "path": "/v1/nothing-here" } },
    { "id": "unknown-v1-route-with-key", "request": { "method": "GET", "path": "/v1/nothing-here", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "usage-trailing-slash", "request": { "method": "GET", "path": "/v1/usage/", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "uppercase-prefix", "request": { "method": "GET", "path": "/V1/usage", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "post-usage", "request": { "method": "POST", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "delete-profile", "request": { "method": "DELETE", "path": "/v1/profiles/PublicPlayer", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "put-healthz", "request": { "method": "PUT", "path": "/healthz" } },
    { "id": "head-usage", "request": { "method": "HEAD", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:annual}}" } } },
    { "id": "get-with-origin", "note": "no Vary, no origin echo: always *", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Origin": "https://client.example", "X-Api-Key": "{{key:annual}}" } } }
  ]
}
