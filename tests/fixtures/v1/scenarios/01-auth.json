{
  "title": "Every route against every authentication case, then the header parsing edge cases",
  "steps": [
    { "id": "profiles-no-key", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer" } },
    { "id": "profiles-malformed", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "Authorization": "Bearer lodb_0123" } } },
    { "id": "profiles-unknown", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "Authorization": "Bearer {{key:unknown}}" } } },
    { "id": "profiles-revoked", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "Authorization": "Bearer {{key:revoked}}" } } },
    { "id": "profiles-inactive", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "X-Api-Key": "{{key:inactive}}" } } },
    { "id": "profiles-bearer", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "Authorization": "Bearer {{key:credits}}" } } },
    { "id": "profiles-x-api-key", "request": { "method": "GET", "path": "/v1/profiles/PublicPlayer", "headers": { "X-Api-Key": "{{key:credits}}" } } },

