    { "id": "usage-no-key", "request": { "method": "GET", "path": "/v1/usage" } },
    { "id": "usage-malformed", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "lodb_0123" } } },
    { "id": "usage-unknown", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:unknown}}" } } },
    { "id": "usage-revoked", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer {{key:revoked}}" } } },
    { "id": "usage-inactive", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer {{key:inactive}}" } } },
    { "id": "usage-bearer", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer {{key:credits}}" } } },
    { "id": "usage-x-api-key", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:credits}}" } } },

    { "id": "malformed-wrong-prefix", "note": "lodx_ instead of lodb_", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "lodx_926c7f2bd824ee97f7e1dc8fa56863b5b9633f40" } } },
    { "id": "malformed-uppercase-hex", "note": "the secret must be lowercase hex", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "lodb_926C7F2BD824EE97F7E1DC8FA56863B5B9633F40" } } },
    { "id": "malformed-too-long", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:credits}}0" } } },
    { "id": "malformed-non-hex", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "lodb_gggggggggggggggggggggggggggggggggggggggg" } } },
    { "id": "bearer-lowercase-scheme", "note": "the Bearer prefix is case-sensitive: no Bearer, no X-Api-Key, so the key is missing", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "bearer {{key:credits}}" } } },
    { "id": "bearer-extra-spaces", "note": "the value after 'Bearer ' is trimmed", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer    {{key:credits}}" } } },
    { "id": "bearer-empty", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer " } } },
    { "id": "x-api-key-padded", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "  {{key:credits}}  " } } },
    { "id": "bearer-wins-over-x-api-key", "note": "a Bearer header is used even when X-Api-Key holds a valid key", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Bearer lodb_0123", "X-Api-Key": "{{key:credits}}" } } },
    { "id": "basic-falls-back-to-x-api-key", "request": { "method": "GET", "path": "/v1/usage", "headers": { "Authorization": "Basic dXNlcjpwYXNz", "X-Api-Key": "{{key:credits}}" } } },
    { "id": "query-string-key-ignored", "request": { "method": "GET", "path": "/v1/usage?api_key={{key:credits}}" } },
    { "id": "unknown-key-again", "note": "same verdict once the rejection is cached", "request": { "method": "GET", "path": "/v1/usage", "headers": { "X-Api-Key": "{{key:unknown}}" } } }
  ]
}
