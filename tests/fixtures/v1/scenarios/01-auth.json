    { "id": "builds-unknown", "request": { "method": "GET", "path": "/v1/champions/Ahri/builds?per_page=1", "headers": { "X-Api-Key": "{{key:unknown}}" } } },
    { "id": "builds-revoked", "request": { "method": "GET", "path": "/v1/champions/Ahri/builds?per_page=1", "headers": { "X-Api-Key": "{{key:revoked}}" } } },
    { "id": "builds-inactive", "request": { "method": "GET", "path": "/v1/champions/Ahri/builds?per_page=1", "headers": { "Authorization": "Bearer {{key:inactive}}" } } },
    { "id": "builds-bearer", "request": { "method": "GET", "path": "/v1/champions/Ahri/builds?per_page=1", "headers": { "Authorization": "Bearer {{key:credits}}" } } },
    { "id": "builds-x-api-key", "request": { "method": "GET", "path": "/v1/champions/Ahri/builds?per_page=1", "headers": { "X-Api-Key": "{{key:credits}}" } } },

