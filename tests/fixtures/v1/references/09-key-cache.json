          "x-ratelimit-reset": "<unix-time>"
        },
        "body": {
          "error": {
            "code": "quota_exceeded",
            "message": "monthly quota exhausted and no credits left"
          }
        }
      }
    },
    {
      "id": "upgraded-old-limit",
      "note": "cached rate limit (the usage body is read from the database)",
      "request": {
        "method": "GET",
        "path": "/v1/usage",
        "headers": {
          "X-Api-Key": "{{key:free}}"
