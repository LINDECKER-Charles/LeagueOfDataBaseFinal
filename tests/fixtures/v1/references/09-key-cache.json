          "access-control-allow-headers": "Authorization, X-Api-Key"
        },
        "body": {
          "error": {
            "code": "unauthorized",
            "message": "unknown API key"
          }
        }
      }
    },
    {
      "id": "topped-up-still-refused",
      "note": "cached credits; L6.3 serves it at once",
      "request": {
        "method": "GET",
        "path": "/v1/trends/runes",
        "headers": {
