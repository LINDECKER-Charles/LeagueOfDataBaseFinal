          "access-control-allow-headers": "Authorization, X-Api-Key",
          "x-ratelimit-limit": "10",
          "x-ratelimit-remaining": "8",
          "x-ratelimit-reset": "<unix-time>"
        },
        "body": {
          "plan": "free",
          "monthly_quota": 500,
          "used_this_month": 0,
          "remaining_this_month": 500,
          "credits_balance": 0,
          "rate_limit_per_min": 10
        }
      }
    },
    {
      "id": "created-still-unknown",
      "note": "cached rejection; L6.3 must not keep a rejection past the key creation",
      "request": {
        "method": "GET",
        "path": "/v1/usage",
        "headers": {
          "X-Api-Key": "{{key:late_key}}"
