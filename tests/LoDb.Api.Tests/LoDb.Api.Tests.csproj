<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!--
      Also referenced by LoDb.Testing, but its build targets only run in the project that
      references it directly: they give this output the API's content root and deps file.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The php:8.5-cli container of the cross-check of the password hashes. -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hashes made by PHP and the script that checks ours, shared with their generator. -->
    <None
      Include="../fixtures/hashes/*"
      LinkBase="fixtures/hashes"
      CopyToOutputDirectory="PreserveNewest" />
    <!-- go-api's /v1 contract recorded by tools/v1-capture/, replayed by PublicApi/. -->
    <None
      Include="../fixtures/v1/**"
      LinkBase="fixtures/v1"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LoDb.Api/LoDb.Api.csproj" />
    <ProjectReference Include="../LoDb.Testing/LoDb.Testing.csproj" />
  </ItemGroup>
</Project>
