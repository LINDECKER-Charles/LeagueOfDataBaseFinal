commande.md

# Agent instructions of this repository: versioned here even when a global excludes file
# ignores AGENTS.md (CLAUDE.md only imports it).
!/AGENTS.md
!/legacy/AGENTS.md

# Env & secrets (see docs/guides/configuration.md).
# Real env files are git-ignored; committed *.example templates and the non-secret
# Symfony defaults of the archived stack (legacy/app/.env, legacy/app/.env.test) are not.

# Repo-root compose env of the new stack (local overrides; ENV_FILE / ENV_FILE on a host)
/.env

# Compose env of the archived legacy stack, read by `docker compose --project-directory legacy`
/legacy/.env
/legacy/.env.test
/legacy/.env.staging
/legacy/.env.prod

# Symfony host-level secret overrides (legacy/app/.gitignore ignores them too)
/legacy/app/.env.local
/legacy/app/.env.*.local

# Node deps anywhere (e.g. legacy/tools/screenshots). Unanchored: matches at any depth.
node_modules/

# JetBrains IDE
.idea/

# Claude Code (réglages et état locaux, propres à chaque poste)
/.claude/

# Pitch Discord (local, non versionné)
/docs/produit/presentation-discord.md

# graphify (cache/rapport knowledge-graph généré)
/graphify-out/
design

# Rapports d'audit générés (knowledge-graph, archi, conventions)
/docs/report/

# Note locale de migration edge -> infra-vps (non versionnee)
/docs/MIGRATION-INFRA-VPS.local.md

# .NET outputs of the new stack. Anchored on src/ and tests/: legacy/app/bin/ holds tracked
# Symfony entry points.
/src/**/bin/
/src/**/obj/
/tests/**/bin/
/tests/**/obj/
TestResults/

# Angular workspace outputs
/src/LoDb.Web/dist/
/src/LoDb.Web/.angular/
/src/LoDb.Web/coverage/

# Parity runs (L1.8): exports and manifests of both stacks, regenerated on demand
/tools/parity/.runs/
