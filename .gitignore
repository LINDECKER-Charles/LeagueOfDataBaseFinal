commande.md

# Env & secrets (see docs/guides/github-actions-secrets.md).
# Real env files are git-ignored; committed *.example templates and the non-secret
# Symfony defaults (app/.env, app/.env.test) are not.

# Repo-root compose env — single source of truth per environment (anchored: only repo root)
/.env
/.env.test
/.env.staging
/.env.prod

# Symfony host-level secret overrides (real secrets live here locally / written by CI)
/app/.env.local
/app/.env.*.local

# Node deps anywhere outside app/ (e.g. tools/screenshots). Unanchored: matches at any depth.
node_modules/

# JetBrains IDE
.idea/

# Claude Code (réglages et état locaux, propres à chaque poste)
/.claude/

# Pitch Discord (local, non versionné)
/docs/produit/presentation-discord.md

# graphify (cache/rapport knowledge-graph généré)
/graphify-out/
design

# Rapports d'audit générés (knowledge-graph, archi, conventions)
/docs/report/

# Note locale de migration edge -> infra-vps (non versionnee)
/docs/MIGRATION-INFRA-VPS.local.md

# .NET outputs of the new stack. Anchored on src/ and tests/: app/bin/ holds tracked
# Symfony entry points.
/src/**/bin/
/src/**/obj/
/tests/**/bin/
/tests/**/obj/
TestResults/

# Angular workspace outputs
/src/LoDb.Web/dist/
/src/LoDb.Web/.angular/
/src/LoDb.Web/coverage/

# Parity runs (L1.8): exports and manifests of both stacks, regenerated on demand
/tools/next/parity/.runs/
