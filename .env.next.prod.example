# Template of ENV_PROD_NEXT: the .env of the new stack in production (project
# lodb-next-prod). The whole file, with real values, is the ENV_PROD_NEXT secret, declared
# in the GitHub environment `production` (never as a repository secret), written to
# ${PROD_NEXT_PATH}/.env by .github/workflows/next-deploy.yml. Every line and where its value
# comes from: docs/guides/configuration.md.
#
# Rules of this file:
# - No empty `LoDb__*` line: comment it out instead. A line present but empty is passed to
#   the API as an empty value, which some settings refuse at startup.
# - A value holding `$` is single-quoted ('…'): Compose interpolates it otherwise.
# - A database password holding `;` breaks the connection string (see LODB_DB_PASSWORD).
# ⚙️ = checked by the deploy job against the target before anything changes.
# 🔁 = value taken over from the legacy stack's ENV_PROD.

# ── Project and images ──────────────────────────────────────────────────────────────
# ⚙️ Never lodb-prod: that is the legacy stack, kept for the rollback.
COMPOSE_PROJECT_NAME=lodb-next-prod
REGISTRY=ghcr.io/lindecker-charles/lodb
# ⚙️ The promoted revision (next-promote.yml retags it). Never `prod`.
IMAGE_TAG=next-prod
# No COMPOSE_PROFILES line: the bundled Postgres stays off, the job forces it empty.

# ── Public hosts ────────────────────────────────────────────────────────────────────
# 🔁 The legacy stack's domains. www. and .fr get a 301 to the canonical host.
CADDY_DOMAINS=league-of-data-base.com, league-of-data-base.fr
API_CADDY_DOMAINS=api.league-of-data-base.com, api.league-of-data-base.fr
LODB_CANONICAL_HOST=league-of-data-base.com
LODB_ALLOWED_HOSTS=league-of-data-base.com
LODB_PUBLIC_API_ORIGIN=https://api.league-of-data-base.com
# docker network inspect edge --format '{{(index .IPAM.Config 0).Subnet}}'
LODB_EDGE_CIDR=172.18.0.0/16
# ⚙️ Production is indexed.
LODB_NOINDEX=0

# ── Database: the legacy stack's PostgreSQL, which never moves ───────────────────────
# ⚙️ Its network: the job refuses to deploy without it, or when it is missing.
LODB_DB_NETWORK=lodb-prod_default
# LODB_DB_HOST and LODB_DB_PORT keep their defaults (postgres, 5432): the legacy service.
# 🔁 POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD of ENV_PROD. The connection string does
# not quote the password: one holding `;` must be changed first (ALTER ROLE on both stacks).
LODB_DB_NAME=lodb
LODB_DB_USER=lodb
LODB_DB_PASSWORD=change_me_legacy_postgres_password

# ── API settings (passed to the API only when present) ──────────────────────────────
# Password of the .pfx of PROD_NEXT_DATA_PROTECTION_PFX, a certificate of production's own.
LoDb__DataProtection__CertificatePassword=change_me
# ⚙️ SMTP relay, required in production. 🔁 From MAILER_DSN of ENV_PROD:
# smtp://USER:PASSWORD@HOST:587 gives Host, Port 587, Security StartTls, Username and
# Password (URL-decoded); smtps://…:465 gives Port 465, Security SslOnConnect.
LoDb__Mail__Host=smtp.example.com
LoDb__Mail__Port=587
LoDb__Mail__Security=StartTls
LoDb__Mail__Username=change_me
LoDb__Mail__Password=change_me
# 🔁 MAILER_FROM. The API's default is on another domain: always set it.
LoDb__Mail__From="LeagueOfDataBase <no-reply@league-of-data-base.com>"
# ⚙️ 🔁 STRIPE_SECRET_KEY (sk_live_…) and STRIPE_WEBHOOK_SECRET of the existing endpoint:
# https://league-of-data-base.com/webhooks/stripe does not change.
LoDb__Billing__StripeSecretKey=sk_live_change_me
LoDb__Billing__StripeWebhookSecret=whsec_change_me
# 🔁 OAUTH_GOOGLE_CLIENT_ID and OAUTH_GOOGLE_CLIENT_SECRET: the same web client, with the
# redirect URI https://league-of-data-base.com/api/account/google/callback added.
LoDb__Accounts__Google__ClientId=change_me.apps.googleusercontent.com
LoDb__Accounts__Google__ClientSecret=change_me
# App clients (desktop: id and secret; Android: id only), never without the web client.
# LoDb__Accounts__Google__AppClients__0__ClientId=change_me.apps.googleusercontent.com
# LoDb__Accounts__Google__AppClients__0__ClientSecret=change_me
# LoDb__Accounts__Google__AppClients__1__ClientId=change_me.apps.googleusercontent.com
# 🔁 CONTACT_RECIPIENT.
LoDb__Contact__Recipient=you@example.com
LoDb__Contact__NotificationLocale=Fr
# 🔁 APP_SECRET of ENV_PROD: the same visitors on both sides of the cutover.
LoDb__Analytics__VisitorKey=change_me_legacy_app_secret

# ── Observability ───────────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
