# Repo-root env for the PRODUCTION stack (docker compose variable substitution).
# Copy to .env.prod (git-ignored) and fill in with prod-grade secrets. Its content is
# stored verbatim as the ENV_PROD GitHub secret; the deploy job writes it to
# ${PROD_PATH}/.env on the server before `docker compose up`. Every line:
# docs/guides/configuration.md.
#
# Rules of this file:
# - No empty `LoDb__*` line but a secret (🔒): comment it out instead. A line present but
#   empty is passed to the API as an empty value, which some settings refuse at startup;
#   an empty secret becomes an empty file, which the API reads as an unset setting.
# - A value holding `$` is single-quoted ('…'): Compose interpolates it otherwise. The
#   deploy job refuses a secret line (🔒) with a `$` outside single quotes.
# 🔒 = secret: on the host, the deploy job moves the line to a file of .deploy/secrets,
#   mounted in /run/secrets of the services that read it (tools/deploy/split-env.sh). It
#   never reaches the .env Compose reads nor a container's environment. Left out or empty,
#   the setting is unset.
# ⚙️ = checked by the deploy job against the target before anything changes.
# 🔁 = value taken over from the legacy stack's prod .env.

# --- Compose project (isolates this env from others on a shared host) ---
# ⚙️ The legacy prod's project: the new stack takes its place (same pgdata volume).
COMPOSE_PROJECT_NAME=lodb-prod

# --- Image registry (GHCR) ---
REGISTRY=ghcr.io/lindecker-charles/lodb
# ⚙️ The images promoted from staging (_promote.yml).
IMAGE_TAG=prod

# --- Public domains (deploy) — DNS must point to the host first ---
# 🔁 www. and .fr get a 301 to the canonical host.
CADDY_DOMAINS=league-of-data-base.com, league-of-data-base.fr
# Only .com: api.league-of-data-base.fr has no DNS record, the edge would fail its certificate.
API_CADDY_DOMAINS=api.league-of-data-base.com
LODB_CANONICAL_HOST=league-of-data-base.com
LODB_ALLOWED_HOSTS=league-of-data-base.com
LODB_PUBLIC_API_ORIGIN=https://api.league-of-data-base.com
# No LODB_EDGE_CIDR: the deploy job reads the edge network's subnet on the host.
# No LODB_STACK_SUBNET: the deploy job sets the stack's subnet per target (10.231.2.0/24).
# No LODB_EDGE_SECRET: the deploy job generates it once on the host (.deploy/secrets).
# ⚙️ Production is indexed.
LODB_NOINDEX=0

# --- PostgreSQL (user accounts, favourites, builds) ---
# 🔁 POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD: the database already lives in the
# project's pgdata volume, created with these credentials. This superuser is migrate's: the
# API connects as its own role, lodb_app.
LODB_DB_NAME=lodb
LODB_DB_USER=lodb
# 🔒 A `;` is allowed: migrate sets the password into its connection string itself.
LODB_DB_PASSWORD=CHANGE_ME
# No LODB_APP_DB_PASSWORD: the password of lodb_app is drawn on the host by the deploy job,
# once, and never leaves it (a dotenv that sets it is refused).
# 🔒 ⚙️ Password of lodb_sauvegarde, the read-only role of the host's off-host backups
# (compose.sauvegarde.yaml, docs/guides/sauvegardes.md), set by migrate: the same value as
# SAUVEGARDE_LODB_MOT_DE_PASSE in infra-vps's SAUVEGARDES_ENV_FILE, drawn once with
# `openssl rand -hex 32` (16 or more letters, digits, '-' or '_'). Empty until the backups are
# activated: the role then has no password and nobody signs in as it.
LoDb__Database__BackupRole__Password=

# --- API settings (passed to the API only when present) ---
# 🔒 Password of the .pfx of the PROD_DATA_PROTECTION_PFX secret.
LoDb__DataProtection__CertificatePassword=change_me
# ⚙️ 🔁 SMTP relay, required in prod, from MAILER_DSN: smtp://USER:PASSWORD@HOST:587 gives
# Host, Port 587, Security StartTls, Username and Password (URL-decoded); smtps://…:465
# gives Port 465, Security SslOnConnect.
LoDb__Mail__Host=smtp.example.com
LoDb__Mail__Port=587
LoDb__Mail__Security=StartTls
LoDb__Mail__Username=change_me
# 🔒
LoDb__Mail__Password=change_me
# 🔁 MAILER_FROM. The API's default is on another domain: always set it.
LoDb__Mail__From="LeagueOfDataBase <no-reply@league-of-data-base.com>"
# 🔒 ⚙️ 🔁 STRIPE_SECRET_KEY (sk_live_…) and STRIPE_WEBHOOK_SECRET of the existing endpoint:
# https://league-of-data-base.com/webhooks/stripe does not change.
LoDb__Billing__StripeSecretKey=sk_live_CHANGE_ME
LoDb__Billing__StripeWebhookSecret=whsec_CHANGE_ME
# 🔁 OAUTH_GOOGLE_CLIENT_ID and 🔒 OAUTH_GOOGLE_CLIENT_SECRET: the same web client, with the
# redirect URI https://league-of-data-base.com/api/account/google/callback added.
LoDb__Accounts__Google__ClientId=change_me.apps.googleusercontent.com
LoDb__Accounts__Google__ClientSecret=change_me
# App clients (desktop: id and 🔒 secret; Android: id only), never without the web client.
# LoDb__Accounts__Google__AppClients__0__ClientId=change_me.apps.googleusercontent.com
# LoDb__Accounts__Google__AppClients__0__ClientSecret=change_me
# LoDb__Accounts__Google__AppClients__1__ClientId=change_me.apps.googleusercontent.com
# 🔁 CONTACT_RECIPIENT.
LoDb__Contact__Recipient=you@example.com
LoDb__Contact__NotificationLocale=Fr
# 🔒 🔁 APP_SECRET: the same visitors on both sides of the switch.
LoDb__Analytics__VisitorKey=change_me_legacy_app_secret
# 🔒 Key of the journal's digests of the identifiers typed on failed sign-ins (openssl rand
# -hex 32). Left out, each process draws its own and the digests stop matching on restart.
LoDb__Audit__IdentifierKey=change_me_openssl_rand_hex_32
# 🔒 The read-only Umami account ("view-only" role, member of the team `lodb`) the API pulls
# the views per page with, for /v1/trends (compose.umami.yaml). Left out: the pull stays
# dormant, the trends keep reading the in-house measure.
# LoDb__Audience__Username=change_me
# LoDb__Audience__Password=change_me
# First day /v1/trends reads Umami's figures instead of the in-house measure (yyyy-MM-dd),
# once two weeks of pulls agree with it. Left out: the in-house measure alone.
# LoDb__Audience__TrendsSwitchDate=2026-10-25

# IndexNow key (`openssl rand -hex 16`), public by design: served at /<key>.txt. Set, each
# promoted patch submits the pages it changed to the IndexNow engines (Bing, Yandex, Naver…).
# Left out: nothing is submitted. Never on staging, which no engine indexes.
# LoDb__Seo__IndexNowKey=change_me_openssl_rand_hex_16

# --- Pre-rendered catalogue (ADR 0011; docs/guides/configuration.md, § 4.8) ---
# The object store of the past patches' pages: Scaleway, fr-par, project lodb-pages-prod,
# set up by tools/prerender/scaleway-bucket.sh (tools/prerender/README.md). While the 🔒 key
# is empty, the pass stays dormant and the SSR renders every page, as before.
LoDb__Prerender__Endpoint=https://s3.fr-par.scw.cloud
LoDb__Prerender__Region=fr-par
LoDb__Prerender__Bucket=lodb-pages-prod
# false until the first full pass is done: an operator launches the prod pass by hand. True
# sooner, the half-hourly reconciliation would open a pass for the previous patch by itself,
# no promotion needed, and the operator's launch would get a 409. Then true: each patch that
# leaves the latest rank joins a pass on the served epoch.
LoDb__Prerender__AutoEnqueueOnPromotion=false
# 🔒 The API key of the IAM application lodb-pages-writer-prod (ObjectStorageObjectsWrite,
# on lodb-pages-prod only): its access key, then its secret key.
LoDb__Prerender__AccessKey=
LoDb__Prerender__SecretKey=
# nginx reads the store anonymously, from the host's address: 1 once
# `scaleway-bucket.sh verifier` has passed on the host. The same bucket as above.
LODB_PAGES_STORE_ENABLED=0
LODB_PAGES_STORE_BUCKET=lodb-pages-prod
# The epoch nginx serves, which the admin panel shows: set to a complete epoch, then
# redeploy. Not LODB_ARCHIVE_EPOCH, the counter of nginx's own cache keys.
LODB_ARCHIVE_SERVE_EPOCH=1
# A past patch's page the SSR renders is kept up to a year (archived s-maxage), and up to
# 90 days unrequested, in nginx's archive cache: the bundles it names are kept longer than
# that. The deploy job refuses less than 395. The store's build/ copy, once
# LODB_PAGES_STORE_ENABLED=1, is only an extra safety net. Without the line: 400 days.
LODB_FRONT_BUILDS_RETENTION_DAYS=400

# --- Scaleway bill in the admin panels (docs/guides/configuration.md, § 4.9) ---
# 🔒 The secret key of the IAM application lodb-facturation-lecture (BillingReadOnly on the
# organization, nothing else), this environment's own. While it is empty, the panels
# "Sauvegardes" and "Précalcul du catalogue" say the bill is not configured.
LoDb__ScalewayBilling__SecretKey=
# The organization, the project of the backups bucket and the project of lodb-pages-prod, as
# UUIDs from the Scaleway console: required once the key is set, refused at startup when they
# are not UUIDs.
# LoDb__ScalewayBilling__OrganizationId=change_me_uuid
# LoDb__ScalewayBilling__BackupsProjectId=change_me_uuid
# LoDb__ScalewayBilling__PagesProjectId=change_me_uuid

# --- Root administrator (the legacy ADMIN_LOGIN / ADMIN_PASSWORD) ---
# 🔁 Kept by the deploy job (`api admin root`) at every deployment: the account named
# LODB_ADMIN_LOGIN, with this password and the admin role; a password changed here is set
# again. Its authenticator (TOTP) is enrolled from the link `api admin mfa-invite --email`
# prints on the host, valid 15 minutes. No quote in the password. The e-mail defaults to
# <login>@<LODB_CANONICAL_HOST>. Left out: no root administrator, `api admin create --email`
# only.
# LODB_ADMIN_LOGIN=change_me
# LODB_ADMIN_PASSWORD=change_me_long_random_secret
# LODB_ADMIN_EMAIL=

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
