# Repo-root env for the STAGING deploy (docker compose variable substitution).
# Copy to .env.staging (git-ignored) and fill in. Its content is stored verbatim as the
# ENV_STAGING GitHub secret; the deploy job writes it to ${STAGING_PATH}/.env on the
# staging server before `docker compose ... up`. Every line: docs/guides/configuration.md.
#
# Local runs need NO .env: compose.yaml defaults every variable. Never copy this file
# to the repository root as .env (its hosts would make the SSR refuse localhost).
#
# Rules of this file:
# - No empty `LoDb__*` line but a secret (🔒): comment it out instead. A line present but
#   empty is passed to the API as an empty value, which some settings refuse at startup;
#   an empty secret becomes an empty file, which the API reads as an unset setting.
# - A value holding `$` is single-quoted ('…'): Compose interpolates it otherwise. The
#   deploy job refuses a secret line (🔒) with a `$` outside single quotes.
# 🔒 = secret: on the host, the deploy job moves the line to a file of .deploy/secrets,
#   mounted in /run/secrets of the services that read it (tools/deploy/split-env.sh). It
#   never reaches the .env Compose reads nor a container's environment. Left out or empty,
#   the setting is unset.
# ⚙️ = checked by the deploy job against the target before anything changes.
# 🔁 = value taken over from the legacy stack's staging .env.

# --- Compose project (isolates this env from others on a shared host) ---
# ⚙️ The legacy staging's project: the new stack takes its place (same pgdata volume).
COMPOSE_PROJECT_NAME=lodb-staging

# --- Image registry (GHCR) ---
REGISTRY=ghcr.io/lindecker-charles/lodb
# ⚙️ Moving tag of the last build of dev.
IMAGE_TAG=staging

# --- Public domains (deploy) — DNS must point to the host first ---
# The API subdomain must start with "api.".
CADDY_DOMAINS=test.league-of-data-base.com
API_CADDY_DOMAINS=api.test.league-of-data-base.com
# Origin of e-mail links, sitemaps, share_url of /v1; target of the www. / .fr 301.
LODB_CANONICAL_HOST=test.league-of-data-base.com
# Hosts the SSR server renders for (comma-separated): the canonical host.
LODB_ALLOWED_HOSTS=test.league-of-data-base.com
# Origin of /v1 that /developers documents: https:// + the first API host.
LODB_PUBLIC_API_ORIGIN=https://api.test.league-of-data-base.com
# No LODB_EDGE_CIDR: the deploy job reads the edge network's subnet on the host.
# No LODB_STACK_SUBNET: the deploy job sets the stack's subnet per target (10.231.1.0/24).
# No LODB_EDGE_SECRET: the deploy job generates it once on the host (.deploy/secrets).
# ⚙️ 1 on staging: "X-Robots-Tag: noindex, nofollow" on every response (never indexed), and a
# 403 for the AI crawlers (docker/nginx/nginx.conf).
LODB_NOINDEX=1

# --- PostgreSQL (user accounts, favourites, builds) ---
# 🔁 POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD: the database already lives in the
# project's pgdata volume, created with these credentials. This superuser is migrate's: the
# API connects as its own role, lodb_app.
LODB_DB_NAME=lodb
LODB_DB_USER=lodb
# 🔒 A `;` is allowed: migrate sets the password into its connection string itself.
LODB_DB_PASSWORD=CHANGE_ME
# No LODB_APP_DB_PASSWORD: the password of lodb_app is drawn on the host by the deploy job,
# once, and never leaves it (a dotenv that sets it is refused).
# No LoDb__Database__BackupRole__Password: the off-host backups are prod's alone
# (compose.sauvegarde.yaml); here the role lodb_sauvegarde has no password.

# --- API settings (passed to the API only when present) ---
# 🔒 Password of the .pfx of the STAGING_DATA_PROTECTION_PFX secret.
LoDb__DataProtection__CertificatePassword=change_me
# 🔁 SMTP relay, from MAILER_DSN: smtp://USER:PASSWORD@HOST:587 gives Host, Port 587,
# Security StartTls, Username and Password (URL-decoded); smtps://…:465 gives Port 465,
# Security SslOnConnect. Left out, e-mails wait in email_outbox.
LoDb__Mail__Host=smtp.example.com
LoDb__Mail__Port=587
LoDb__Mail__Security=StartTls
LoDb__Mail__Username=change_me
# 🔒
LoDb__Mail__Password=change_me
# 🔁 MAILER_FROM.
LoDb__Mail__From="LeagueOfDataBase <no-reply@test.league-of-data-base.com>"
# 🔒 🔁 STRIPE_SECRET_KEY (sk_test_…) and STRIPE_WEBHOOK_SECRET of the staging endpoint
# https://test.league-of-data-base.com/webhooks/stripe.
LoDb__Billing__StripeSecretKey=sk_test_CHANGE_ME
LoDb__Billing__StripeWebhookSecret=whsec_CHANGE_ME
# 🔁 OAUTH_GOOGLE_CLIENT_ID / 🔒 _SECRET (redirect https://<canonical>/api/account/google/callback).
# Both or none.
# LoDb__Accounts__Google__ClientId=change_me.apps.googleusercontent.com
# LoDb__Accounts__Google__ClientSecret=change_me
# App clients (desktop: id and 🔒 secret; Android: id only), never without the web client.
# LoDb__Accounts__Google__AppClients__0__ClientId=change_me.apps.googleusercontent.com
# LoDb__Accounts__Google__AppClients__0__ClientSecret=change_me
# LoDb__Accounts__Google__AppClients__1__ClientId=change_me.apps.googleusercontent.com
# 🔁 CONTACT_RECIPIENT: messages are stored for the admin inbox; the recipient also gets
# them by e-mail. Locale: Ar Cs De El En Es Fr Hu Id It Ja Ko Pl Pt Ro Ru Th Tr Vi ZhHans
# ZhHant.
LoDb__Contact__Recipient=you@example.com
LoDb__Contact__NotificationLocale=Fr
# 🔒 🔁 APP_SECRET: key of the visitor hash (openssl rand -hex 32 otherwise).
LoDb__Analytics__VisitorKey=change_me_openssl_rand_hex_32
# 🔒 Key of the journal's digests of the identifiers typed on failed sign-ins (openssl rand
# -hex 32). Left out, each process draws its own and the digests stop matching on restart.
LoDb__Audit__IdentifierKey=change_me_openssl_rand_hex_32

# --- Share of the host (compose.staging.yaml, added by the deploy job on staging) ---
# Staging runs on the production host with about 0.75 core in all. These are the overlay's
# defaults: set a line only to change one (docs/guides/configuration.md, § 4.5).
# LODB_RENDER_MAX_IN_FLIGHT=3
# LODB_PINNED_RENDER_MAX_IN_FLIGHT=1
# LODB_PINNED_RENDERS_PER_MINUTE=10
# LODB_PINNED_RENDER_BURST=5
# LODB_PRERENDER_RENDERS_PER_MINUTE=30
# LODB_PRERENDER_RENDER_BURST=5
# LODB_PRERENDER_MAX_IN_FLIGHT=1
# LODB_PRERENDER_VISITOR_RESERVE=1
# LoDb__Ingestion__SyncConcurrency=1
# LoDb__Ingestion__LanguageConcurrency=1
# LoDb__Egress__FetchConcurrency=1

# --- Login on the pages (compose.staging-auth.yaml), optional ---
# Both lines or neither. With both, the deploy job adds the overlay and the edge asks for
# this login on the pages, never on /api/, /v1/, /webhooks/, /healthz, /build/, /cdn/blobs/
# nor /u/. The user: letters, digits and '-'. The hash: bcrypt from
# `caddy hash-password` (the edge's container has it), single-quoted. Read the trade-off in
# docs/guides/configuration.md, § 4.5, before enabling it.
# LODB_STAGING_BASIC_AUTH_USER=change-me
# LODB_STAGING_BASIC_AUTH_HASH='$2a$14$change_me'

# --- Pre-rendered catalogue (ADR 0011; docs/guides/configuration.md, § 4.8) ---
# The object store of the past patches' pages: Scaleway, fr-par, project lodb-pages-staging,
# set up by tools/prerender/scaleway-bucket.sh (tools/prerender/README.md). While the 🔒 key
# is empty, the pass stays dormant and the SSR renders every page, as before.
LoDb__Prerender__Endpoint=https://s3.fr-par.scw.cloud
LoDb__Prerender__Region=fr-par
LoDb__Prerender__Bucket=lodb-pages-staging
# Never by itself on staging: an operator launches small passes (ADR 0011).
LoDb__Prerender__AutoEnqueueOnPromotion=false
# 🔒 The API key of the IAM application lodb-pages-writer-staging (ObjectStorageObjectsWrite,
# on lodb-pages-staging only): its access key, then its secret key.
LoDb__Prerender__AccessKey=
LoDb__Prerender__SecretKey=
# nginx reads the store anonymously, from the host's address: 1 once
# `scaleway-bucket.sh verifier` has passed on the host. The same bucket as above.
LODB_PAGES_STORE_ENABLED=0
LODB_PAGES_STORE_BUCKET=lodb-pages-staging
# The epoch nginx serves, which the admin panel shows: set to a complete epoch, then
# redeploy. Not LODB_ARCHIVE_EPOCH, the counter of nginx's own cache keys.
LODB_ARCHIVE_SERVE_EPOCH=1
# A past patch's page the SSR renders stays up to 90 days unrequested in nginx's archive
# cache (LODB_ARCHIVE_CACHE_INACTIVE), after a week of s-maxage: the bundles it names are kept
# longer than that (90 + 7 days). The store's build/ copy, once LODB_PAGES_STORE_ENABLED=1, is
# only an extra safety net. Without the line: 30 days.
LODB_FRONT_BUILDS_RETENTION_DAYS=100

# --- Root administrator (the legacy ADMIN_LOGIN / ADMIN_PASSWORD) ---
# 🔁 Kept by the deploy job (`api admin root`) at every deployment: the account named
# LODB_ADMIN_LOGIN, with this password and the admin role; a password changed here is set
# again. Its authenticator (TOTP) is enrolled from the link `api admin mfa-invite --email`
# prints on the host, valid 15 minutes. No quote in the password. The e-mail defaults to
# <login>@<LODB_CANONICAL_HOST>. Left out: no root administrator, `api admin create --email`
# only.
# LODB_ADMIN_LOGIN=change_me
# LODB_ADMIN_PASSWORD=change_me_long_random_secret
# LODB_ADMIN_EMAIL=

# --- Observability ---
# OTLP endpoint of a trace collector; unset keeps the traces local (log correlation).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
