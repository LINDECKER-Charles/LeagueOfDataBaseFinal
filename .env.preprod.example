# Template of the .env of the `preprod` environment (pre-production). The whole file, with
# real values, is the ENV_FILE secret of the GitHub environment `preprod`, written to
# /opt/lodb-preprod/.env by .github/workflows/deploy.yml. Production has its own template,
# .env.production.example. Every line: docs/guides/configuration.md.
#
# Local runs need NO .env: compose.yaml defaults every variable. Never copy this file
# to the repository root on a workstation (its hosts would make the SSR refuse localhost).
#
# Rules of this file:
# - No empty `LoDb__*` line: comment it out instead. A line present but empty is passed to
#   the API as an empty value, which some settings refuse at startup.
# - A value holding `$` is single-quoted ('…'): Compose interpolates it otherwise.
# - Passwords: hexadecimal (openssl rand -hex 24). A `;` breaks the connection string.
# ⚙️ = checked by the deploy job against the target before anything changes.

# ── Project and images ──────────────────────────────────────────────────────────────
# ⚙️ Distinct project per environment: never lodb-prod, lodb-staging nor lodb-production.
COMPOSE_PROJECT_NAME=lodb-preprod
REGISTRY=ghcr.io/lindecker-charles/lodb
# ⚙️ Moving tag of the last build of dev.
IMAGE_TAG=preprod
# The stack's own Postgres. The deploy job sets it itself; this line serves the docker
# compose commands run by hand on the host.
COMPOSE_PROFILES=bundled-database

# ── Public hosts ────────────────────────────────────────────────────────────────────
# DNS of both names points to the host first (TLS check of the job). The API subdomain
# must start with "api.". test.league-of-data-base.com is the legacy staging's domain, the
# one the desktop beta channel targets: stop the legacy staging's nginx and go-api first,
# the job never takes a domain over on preprod.
CADDY_DOMAINS=test.league-of-data-base.com
API_CADDY_DOMAINS=api.test.league-of-data-base.com
# Origin of e-mail links, sitemaps, share_url of /v1; target of the www. / .fr 301.
LODB_CANONICAL_HOST=test.league-of-data-base.com
# Hosts the SSR server renders for (comma-separated): the canonical host.
LODB_ALLOWED_HOSTS=test.league-of-data-base.com
# Origin of /v1 that /developers documents: https:// + the first API host.
LODB_PUBLIC_API_ORIGIN=https://api.test.league-of-data-base.com
# Subnet of the external edge network, the only peer trusted for X-Forwarded-For:
#   docker network inspect edge --format '{{(index .IPAM.Config 0).Subnet}}'
LODB_EDGE_CIDR=172.18.0.0/16
# ⚙️ 1 on preprod: "X-Robots-Tag: noindex, nofollow" on every response (never indexed).
LODB_NOINDEX=1

# ── Database (the stack's own Postgres, anonymized dump) ────────────────────────────
# ⚙️ LODB_DB_NETWORK stays unset on preprod: it must never reach production's database.
# LODB_DB_HOST and LODB_DB_PORT keep their defaults (postgres, 5432).
LODB_DB_NAME=lodb
LODB_DB_USER=lodb
LODB_DB_PASSWORD=change_me_openssl_rand_hex_24

# ── API settings (passed to the API only when present) ──────────────────────────────
# Password of the .pfx of the DATA_PROTECTION_PFX secret.
LoDb__DataProtection__CertificatePassword=change_me
# SMTP relay. Left out on preprod: e-mails wait in email_outbox, nothing real is sent (wanted
# while preprod serves a copy of real data, docs/reecriture/bascule.md § 3.2).
# LoDb__Mail__Host=smtp.example.com
# LoDb__Mail__Port=587
# LoDb__Mail__Security=StartTls
# LoDb__Mail__Username=change_me
# LoDb__Mail__Password=change_me
# LoDb__Mail__From="LeagueOfDataBase <no-reply@league-of-data-base.com>"
# Stripe TEST keys, and the secret of preprod's own endpoint https://<canonical>/webhooks/stripe.
LoDb__Billing__StripeSecretKey=sk_test_change_me
LoDb__Billing__StripeWebhookSecret=whsec_change_me
# Google web client (redirect https://<canonical>/api/account/google/callback). Both or none.
# LoDb__Accounts__Google__ClientId=change_me.apps.googleusercontent.com
# LoDb__Accounts__Google__ClientSecret=change_me
# App clients (desktop: id and secret; Android: id only), never without the web client.
# LoDb__Accounts__Google__AppClients__0__ClientId=change_me.apps.googleusercontent.com
# LoDb__Accounts__Google__AppClients__0__ClientSecret=change_me
# LoDb__Accounts__Google__AppClients__1__ClientId=change_me.apps.googleusercontent.com
# Contact form: messages are stored for the admin inbox; a recipient also gets them by
# e-mail (needs LoDb__Mail__Host). Locale: Ar Cs De El En Es Fr Hu Id It Ja Ko Pl Pt Ro Ru
# Th Tr Vi ZhHans ZhHant.
# LoDb__Contact__Recipient=you@example.com
# LoDb__Contact__NotificationLocale=Fr
# Key of the visitor hash (openssl rand -hex 32). Unset: a random key per process.
LoDb__Analytics__VisitorKey=change_me_openssl_rand_hex_32

# ── Observability ───────────────────────────────────────────────────────────────────
# OTLP endpoint of a trace collector; unset keeps the traces local (log correlation).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318

# ── Workstation only: host ports of compose.override.yaml (plan §6.3) ─────────
# Never on a host. Integration stack defaults: 18080 18081 18082 15432 18025; slot 1:
# 18180 18181 18182 15532 18125; slot 2: 18280 18281 18282 15632 18225. Pass them on the
# command line (LODB_HTTP_PORT=18180 docker compose …).
